"use client";

import type { ReactNode } from "react";
import { usePathname } from "next/navigation";
import Link from "@/components/LocLink";
import { useAuth } from "./AuthProvider";
import { useT } from "./LangProvider";
import { splitLang, type DictKey } from "@/lib/i18n";

// Each page of the menu: its address, its name (the menu and the page's title) and the short line under the title.
const ITEMS: Array<[string, DictKey, DictKey]> = [
  ["/account", "account_hub_title", "acct_desc_account"], ["/account/loyalty", "loyalty_my_tier_title", "acct_desc_tier"], ["/orders", "orders_and_returns", "acct_desc_orders"],
  ["/returns", "my_returns", "acct_desc_returns"], ["/addresses", "addresses", "acct_desc_addresses"], ["/garage", "garage_title", "acct_desc_garage"], ["/wishlist", "wishlist", "acct_desc_wishlist"],
  ["/saved-searches", "saved_searches", "acct_desc_saved"], ["/referrals", "referrals", "acct_desc_referrals"], ["/account/change-email", "change_email", "acct_desc_email"],
  ["/account/two-factor", "two_factor_auth_label", "acct_desc_two_factor"], ["/contact", "contact_us_label", "contact_page_lead"],
];

// Beside the menu every page starts 32 px from it (its own side padding) and has the same width (the widest of them, My garage: 1024 px, so no page gets narrower), so their edges line up
// as the buyer moves through the menu. The pages themselves are not changed: this only places them. On a phone the pages are as they are.
// Every page of the menu opens with the same header box: its title and a short line about it. The page's own title is then not shown (the box says it), and the
// page starts just under the box.
const PAGE_PLACE_CSS = `@media (min-width: 1024px) { .account-page > *, .account-body > * { margin-inline-start: 0 !important; margin-inline-end: auto !important; max-width: 64rem !important; } }
.account-body h1, .account-body [data-page-lead] { display: none !important; }
.account-body > * { padding-top: 20px !important; }`;

/** Whether this address is one of the menu's pages (or a page inside one: an order, a return, a vehicle): the menu stays on all of them. */
export function inAccountMenu(path: string): boolean {
  return ITEMS.some(([href]) => path === href || path.startsWith(`${href}/`));
}

/**
 * The account menu. It stays on EVERY page it lists (and the pages inside them), at the far start side of the window: the far left in English, the far
 * right in Arabic. Each page keeps its own layout beside it; on a phone the menu sits above the page. It wraps the whole site (app/layout.tsx) and does
 * nothing anywhere else. A visitor who is not signed in gets the page alone: it asks them to sign in.
 */
export default function AccountShell({ children }: { children: ReactNode }) {
  const { user } = useAuth();
  const t = useT();
  const here = splitLang(usePathname() || "/").path;
  if (!user || !inAccountMenu(here)) return <>{children}</>;
  // the pages under /account were drawn for the space beside the menu and have no frame of their own: they keep the one they had
  const ownFrame = here === "/account" || here.startsWith("/account/");
  const item = ITEMS.find(([href]) => href === here);      // the header box: on the menu's own pages (an order or a return keeps its own title)
  return (
    <div className="lg:flex lg:items-start">
      <style>{PAGE_PLACE_CSS}</style>
      <nav aria-label={t("account_sidebar")} className="px-4 pt-6 lg:sticky lg:top-4 lg:w-[256px] lg:shrink-0 lg:self-start lg:pe-0 lg:ps-4 lg:pt-10">
        <ul className="grid gap-1 rounded-[14px] border border-line bg-white p-2">
          {ITEMS.map(([href, key]) => (
            <li key={href}>
              <Link href={href} aria-current={here === href ? "page" : undefined} className={`flex min-h-11 items-center rounded-lg px-3 text-[15px] font-semibold ${here === href ? "bg-navy text-white" : "text-ink hover:bg-chalk"}`}>{t(key)}</Link>
            </li>
          ))}
        </ul>
      </nav>
      <div className="account-page min-w-0 flex-1">
        {item && (
          <div className="px-4 pt-6 sm:px-8 lg:pt-10">
            <header data-testid="account-page-header" className="relative overflow-hidden rounded-[16px] border border-line bg-white px-6 py-5 sm:px-7">
              <span aria-hidden="true" className="absolute inset-y-4 start-0 w-1 rounded-full bg-signal" />
              <h1 className="text-3xl font-bold tracking-tight text-navy">{t(item[1])}</h1>
              <p className="mt-1.5 text-[15px] text-muted">{t(item[2])}</p>
            </header>
          </div>
        )}
        <div className={item ? "account-body" : undefined}>{ownFrame ? <div className="mx-auto max-w-4xl px-4 py-10 sm:px-8">{children}</div> : children}</div>
      </div>
    </div>
  );
}
