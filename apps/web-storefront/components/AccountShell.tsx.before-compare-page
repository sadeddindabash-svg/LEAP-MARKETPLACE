/** How many notifications are not read yet, for the gold number beside Notifications in the menu (checked again every 30 seconds and on each page). */
function useUnread(on: boolean, here: string): number {
  const [n, setN] = useState(0);
  useEffect(() => {
    if (!on) return;
    const token = getAuthToken();
    if (!token) return;
    let live = true;
    const load = () => fetchUnreadNotificationCount(token).then((c) => { if (live) setN(c); }).catch(() => {});
    load();
    const timer = setInterval(load, 30_000);
    return () => { live = false; clearInterval(timer); };
  }, [on, here]);
  return n;
}

// Pages reached from one of the menu's pages: the menu stays on them too, with that page marked (Contact us leads to Support and to Report a bug).
const REACHED_FROM: Array<[string, string]> = [["/support", "/contact"], ["/report-bug", "/contact"]];
const under = (path: string, href: string) => path === href || path.startsWith(`${href}/`);

/** The menu's page this address belongs to: the page itself, the page it is inside (an order, a return), or the page it is reached from; null elsewhere. */
export function menuPageOf(path: string): string | null {
  const own = ITEMS.filter(([href]) => under(path, href)).sort((a, b) => b[0].length - a[0].length)[0];
  if (own) return own[0];
  const from = REACHED_FROM.find(([prefix]) => under(path, prefix));
  return from ? from[1] : null;
}

/** Whether the menu stays on this address: every page it lists, the pages inside them, and the pages reached from them. */
export function inAccountMenu(path: string): boolean {
  return menuPageOf(path) !== null;
}

/**
 * The account menu. It stays on EVERY page it lists (and the pages inside them), at the far start side of the window: the far left in English, the far
 * right in Arabic. Each page keeps its own layout beside it; on a phone the menu sits above the page. It wraps the whole site (app/layout.tsx) and does
 * nothing anywhere else. A visitor who is not signed in gets the page alone: it asks them to sign in.
 */
export default function AccountShell({ children }: { children: ReactNode }) {
  const { user } = useAuth();
  const t = useT();
  const here = splitLang(usePathname() || "/").path;
  const unread = useUnread(!!user && inAccountMenu(here), here);
  if (!user || !inAccountMenu(here)) return <>{children}</>;
  // the pages under /account were drawn for the space beside the menu and have no frame of their own: they keep the one they had
  const ownFrame = here === "/account" || here.startsWith("/account/");
  const item = ITEMS.find(([href]) => href === here);
  const marked = menuPageOf(here);      // the menu's page to mark: this page, or the one it belongs to      // the header box: on the menu's own pages (an order or a return keeps its own title)
  return (
    <div className="lg:flex lg:items-start">
      <style>{`${PAGE_PLACE_CSS}\n${THEME_CSS}`}</style>
      <nav aria-label={t("account_sidebar")} className="px-4 pt-6 lg:sticky lg:top-[calc(var(--header-h,0px)+1rem)] lg:w-[256px] lg:shrink-0 lg:self-start lg:pe-0 lg:ps-4 lg:pt-10">
        <ul className="grid gap-1 rounded-[14px] border border-line bg-white p-2">
          {ITEMS.map(([href, key]) => (
            <li key={href}>
              <Link href={href} aria-current={here === href ? "page" : marked === href ? "true" : undefined} className={`relative flex min-h-11 items-center gap-2.5 rounded-[10px] px-3 text-[15px] font-semibold ${marked === href ? "bg-gradient-to-br from-navy to-[#173f57] text-white" : "text-ink hover:bg-chalk"}`}>
                {marked === href && <span aria-hidden="true" className="absolute inset-y-2.5 start-0 w-[3px] rounded-full bg-signal" />}
                <span className={`flex-none ${marked === href ? "text-signal" : "text-[#8a97a3]"}`}><Icon href={href} size={18} /></span>
                <span className="min-w-0 flex-1">{t(key)}</span>
                {href === "/notifications" && unread > 0 && <span aria-hidden="true" data-testid="menu-unread" className="flex h-5 min-w-5 flex-none items-center justify-center rounded-full bg-signal px-1.5 text-xs font-extrabold text-navy">{unread > 99 ? "99+" : unread}</span>}
              </Link>
            </li>
          ))}
        </ul>
      </nav>
      <div className={`account-page min-w-0 flex-1${item && item[0] === TIER ? "" : " account-themed"}`}>
        {item && item[0] !== TIER && (
          <div className="px-4 pt-6 sm:px-8 lg:pt-10">
            <header data-testid="account-page-header" className="relative flex flex-wrap items-center gap-x-5 gap-y-3 overflow-hidden rounded-[16px] bg-gradient-to-br from-navy to-[#173f57] px-6 py-5 text-white sm:px-7">
              <span aria-hidden="true" className="grid size-14 flex-none place-items-center rounded-full bg-white text-navy ring-4 ring-signal"><Icon href={item[0]} size={26} /></span>
              <div className="min-w-0 flex-1">
                <h1 className="text-[26px] font-extrabold leading-tight tracking-tight text-white">{t(item[1])}</h1>
                <p className="mt-1 text-[15px] font-semibold text-signal">{t(item[2])}</p>
              </div>
              {/* My garage: how many of its places are used, at the end of the title box */}
              {item[0] === "/garage" && <GarageMeter />}
            </header>
          </div>
        )}
        {item && item[0] === TIER && (
          <div className="px-4 pt-6 sm:px-8 lg:pt-10">
            <header data-testid="account-page-header" className="relative flex flex-wrap items-center gap-x-6 gap-y-3 overflow-hidden rounded-[16px] border border-line bg-white px-6 py-5 sm:px-7">
              <span aria-hidden="true" className="absolute inset-y-4 start-0 w-1 rounded-full bg-signal" />
              <div className="min-w-0 flex-1">
                <h1 className="text-3xl font-bold tracking-tight text-navy">{t(item[1])}</h1>
                <p className="mt-1.5 text-[15px] text-muted">{t(item[2])}</p>
              </div>
              {/* My garage: how many of its places are used, at the end of the title box */}
              {item[0] === "/garage" && <GarageMeter />}
            </header>
          </div>
        )}
        <div className={item ? "account-body" : "account-sub"}>{ownFrame ? <div className="account-frame mx-auto max-w-4xl px-4 py-10 sm:px-8">{children}</div> : children}</div>
      </div>
    </div>
  );
}
