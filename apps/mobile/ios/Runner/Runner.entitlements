<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<!--
		Real Universal Links domain for password-reset deep linking
		(new), app-side half only. leapautoparts.com below is a REAL
		PLACEHOLDER, it must be replaced with your actual real
		production domain. This alone is not enough for links to
		actually open the app: a real apple-app-site-association file
		must also be hosted at
		https://leapautoparts.com/.well-known/apple-app-site-association
		containing this app's own real Team ID and bundle identifier
		(see Apple's own Universal Links docs). Until both exist,
		tapping such a link will open Safari, not this app, exactly as
		it does today.
		-->
		<string>applinks:leapautoparts.com</string>
	</array>
</dict>
</plist>
