<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- REAL BUG FOUND AND FIXED HERE: android:usesCleartextTraffic
         was previously orphaned OUTSIDE the application tag (a stray
         closing angle bracket after android:icon closed the tag one
         attribute too early), genuinely invalid XML, meaning this
         attribute was never actually being applied to the real app
         at all. -->
    <!-- Real permission for biometric app lock (new), required by
         local_auth on Android for Face ID/fingerprint/device-credential
         authentication. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application
        android:label="leap_mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
              Real App Links intent-filter for password-reset deep
              linking (new), app-side half only. android:autoVerify
              makes Android attempt real domain verification, but that
              verification will genuinely fail until two more real,
              external things exist, neither of which can be set up
              from here:
                1. leapautoparts.com below is a REAL PLACEHOLDER, it
                   must be replaced with your actual real production
                   domain.
                2. A real /.well-known/assetlinks.json file must be
                   hosted at that real domain, containing this app's
                   own real release-signing certificate's SHA-256
                   fingerprint (see Android's own App Links docs).
              Until both exist, this intent-filter is harmless but
              inactive, tapping such a link will open a browser, not
              this app, exactly as it does today.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="leapautoparts.com" android:pathPrefix="/reset-password"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
