class MyQuotationsScreen extends StatefulWidget {
  const MyQuotationsScreen({super.key});
  @override
  State<MyQuotationsScreen> createState() => _MyQuotationsScreenState();
}

class _MyQuotationsScreenState extends State<MyQuotationsScreen> {
  List<dynamic>? _list;
  String? _error;

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) => _load());
  }

  Future<void> _load() async {
    final token = context.read<AuthState>().token;
    if (token == null) return;
    try {
      final l = await QuotationsApi().mine(token, _lang(context));
      if (mounted) setState(() { _list = l; _error = null; });
    } catch (e) {
      if (mounted) setState(() => _error = _errorText(context, e));
    }
  }

  @override
  Widget build(BuildContext context) {
    final p = LeapPalette.of(context);
    if (!context.watch<AuthState>().isLoggedIn) return _signIn(context, qtr(context, 'my_quotations'));
    final list = _list;
    return Scaffold(
      appBar: AppBar(title: Text(qtr(context, 'my_quotations'))),
      body: _error != null
          ? Center(child: Column(mainAxisSize: MainAxisSize.min, children: [Text(_error!), TextButton(onPressed: _load, child: Text(qtr(context, 'retry')))]))
          : list == null
              ? const Center(child: CircularProgressIndicator())
              : RefreshIndicator(
                  onRefresh: _load,
                  child: list.isEmpty
                      ? ListView(children: [Padding(padding: const EdgeInsets.all(24), child: Text(qtr(context, 'none_yet'), textAlign: TextAlign.center, style: TextStyle(color: p.muted)))])
                      : ListView.builder(
                          padding: const EdgeInsets.all(16),
                          itemCount: list.length,
                          itemBuilder: (context, i) {
                            final q = list[i] as Map<String, dynamic>;
                            final state = q['state'] as String;
                            final party = q['party'] as Map<String, dynamic>;
                            return Card(
                              margin: const EdgeInsets.only(bottom: 10),
                              child: ListTile(
                                onTap: () => context.push('/quotations/${Uri.encodeComponent(q['id'] as String)}'),
                                title: Row(children: [
                                  Text(q['id'] as String, style: const TextStyle(fontWeight: FontWeight.w800), textDirection: TextDirection.ltr),
                                  const SizedBox(width: 8),
                                  Container(
                                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 2),
                                    decoration: BoxDecoration(color: _stateBack(state), borderRadius: BorderRadius.circular(99)),
                                    child: Text(qtr(context, 'badge_$state'), style: TextStyle(color: _stateColor(state), fontSize: 11.5, fontWeight: FontWeight.w700)),
                                  ),
                                ]),
                                subtitle: Text('${party['name']} · ${qtr(context, 'party_${party['type']}')} · ${_vehicleLine(q['vehicle'] as Map<String, dynamic>)} · ${qtr(context, 'parts_count').replaceAll('{n}', '${q['itemCount']}')}\n${qtr(context, 'valid_until')} ${_date(context, q['expiresAt'] as String)}'),
                                isThreeLine: true,
                                trailing: Text(_money(context, q['totalUsd'] as num, q['currency'] as Map<String, dynamic>), style: TextStyle(fontWeight: FontWeight.w800, color: p.ink)),
                              ),
                            );
                          },
                        ),
                ),
    );
  }
}

// ---------------------------------------------------------------------------------------------------------------- One quotation

class QuotationDetailScreen extends StatefulWidget {
  final String quotationId;
  const QuotationDetailScreen({super.key, required this.quotationId});
  @override
  State<QuotationDetailScreen> createState() => _QuotationDetailScreenState();
}

class _QuotationDetailScreenState extends State<QuotationDetailScreen> {
  Map<String, dynamic>? _q;
  String? _error;
  bool _busy = false;

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) => _load());
  }

  Future<void> _load() async {
    final token = context.read<AuthState>().token;
    if (token == null) return;
    try {
      final q = await QuotationsApi().one(token, widget.quotationId, _lang(context));
      if (mounted) setState(() { _q = q; _error = null; });
    } catch (e) {
      if (mounted) setState(() => _error = _errorText(context, e));
    }
  }

  Future<void> _open(String url) async {
    await launchUrl(Uri.parse(url), mode: LaunchMode.externalApplication);
  }

  Future<void> _renew() async {
    final token = context.read<AuthState>().token;
    if (token == null) return;
    setState(() => _busy = true);
    try {
      final next = await QuotationsApi().renew(token, widget.quotationId, _lang(context), context.read<CurrencyState>().currencyCode);
      if (mounted) context.pushReplacement('/quotations/${Uri.encodeComponent(next['id'] as String)}');
    } catch (e) {
      if (mounted) setState(() { _error = _errorText(context, e); _busy = false; });
    }
  }

  @override
  Widget build(BuildContext context) {
    final p = LeapPalette.of(context);
    if (!context.watch<AuthState>().isLoggedIn) return _signIn(context, qtr(context, 'my_quotations'));
    final q = _q;
    return Scaffold(
      appBar: AppBar(title: Text(widget.quotationId, textDirection: TextDirection.ltr)),
      body: _error != null && q == null
          ? Center(child: Column(mainAxisSize: MainAxisSize.min, children: [Text(_error!), TextButton(onPressed: _load, child: Text(qtr(context, 'retry')))]))
          : q == null
              ? const Center(child: CircularProgressIndicator())
              : RefreshIndicator(onRefresh: _load, child: ListView(padding: const EdgeInsets.all(16), children: _body(context, p, q))),
    );
  }

  List<Widget> _body(BuildContext context, LeapPalette p, Map<String, dynamic> q) {
    final state = q['state'] as String;
    final currency = q['currency'] as Map<String, dynamic>;
    final party = q['party'] as Map<String, dynamic>;
    final link = (q['link'] as String?) ?? '';
    final items = (q['items'] as List).cast<Map<String, dynamic>>();
    final shares = (q['shares'] as List).cast<Map<String, dynamic>>();
    final stateText = switch (state) {
      'open' => qtr(context, 'state_open').replaceAll('{date}', _date(context, q['expiresAt'] as String)),
      'expired' => qtr(context, 'state_expired').replaceAll('{date}', _date(context, q['expiresAt'] as String)),
      'ordered' => qtr(context, 'state_ordered').replaceAll('{order}', '${q['orderId'] ?? ''}'),
      _ => qtr(context, 'state_cancelled'),
    };
    return [
      Container(
        padding: const EdgeInsets.all(14),
        margin: const EdgeInsets.only(bottom: 12),
        decoration: BoxDecoration(color: _stateBack(state), borderRadius: BorderRadius.circular(12)),
        child: Row(children: [
          Icon(state == 'open' || state == 'ordered' ? Icons.verified_outlined : Icons.error_outline, color: _stateColor(state)),
          const SizedBox(width: 8),
          Expanded(child: Text(stateText, style: TextStyle(color: _stateColor(state), fontWeight: FontWeight.w800))),
          if (state == 'ordered' && q['orderId'] != null) TextButton(onPressed: () => context.push('/orders/${q['orderId']}'), child: Text(qtr(context, 'view_order'))),
        ]),
      ),
      if (state == 'open')
        _Card(title: qtr(context, 'send_title'), children: [
          Text(qtr(context, 'send_lead'), style: TextStyle(color: p.muted, fontSize: 13)),
          const SizedBox(height: 10),
          Container(
            padding: const EdgeInsets.all(10),
            decoration: BoxDecoration(color: p.chalk, borderRadius: BorderRadius.circular(8)),
            child: Text(link, textDirection: TextDirection.ltr, style: const TextStyle(fontSize: 13)),
          ),
          const SizedBox(height: 10),
          Wrap(spacing: 8, runSpacing: 8, children: [
            OutlinedButton.icon(
              icon: const Icon(Icons.copy, size: 18),
              label: Text(qtr(context, 'copy')),
              onPressed: () async {
                await Clipboard.setData(ClipboardData(text: link));
                if (context.mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(qtr(context, 'copied'))));
              },
            ),
            OutlinedButton.icon(icon: const Icon(Icons.share, size: 18), label: Text(qtr(context, 'share')), onPressed: () => Share.share('${q['id']} — $link')),
            OutlinedButton.icon(icon: const Icon(Icons.picture_as_pdf_outlined, size: 18), label: Text(qtr(context, 'pdf')), onPressed: () => _open('$link/print')),
          ]),
          const SizedBox(height: 6),
          TextButton(onPressed: () => _open(link), child: Text(qtr(context, 'confirm_shares'))),
          if (q['openCount'] != null) Text(qtr(context, 'opened').replaceAll('{n}', '${q['openCount']}'), style: TextStyle(color: p.muted, fontSize: 12)),
        ]),
      if (state == 'expired')
        Padding(padding: const EdgeInsets.only(bottom: 12), child: ElevatedButton(onPressed: _busy ? null : _renew, child: Text(qtr(context, 'renew')))),
      _Card(children: [
        Text('${party['name']} · ${qtr(context, 'party_${party['type']}')}', style: const TextStyle(fontWeight: FontWeight.w800)),
        if (party['policyNumber'] != null) Text('${qtr(context, 'policy').replaceAll(RegExp(r' \(.*\)'), '')}: ${party['policyNumber']}', style: TextStyle(color: p.muted)),
        Text(_vehicleLine(q['vehicle'] as Map<String, dynamic>), style: TextStyle(color: p.muted)),
        Text('${qtr(context, 'issued')} ${_date(context, q['createdAt'] as String)}', style: TextStyle(color: p.muted, fontSize: 12.5)),
        const Divider(height: 22),
        for (final i in items)
          Padding(
            padding: const EdgeInsets.only(bottom: 10),
            child: Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                Text('${i['name']} × ${i['quantity']}', style: const TextStyle(fontWeight: FontWeight.w700)),
                Text('${qtr(context, 'seller')}: ${i['seller'] ?? '—'} · ${qtr(context, 'valid_until')} ${_date(context, i['validUntil'] as String)}', style: TextStyle(color: p.muted, fontSize: 12)),
              ])),
              Text(_money(context, i['totalUsd'] as num, currency), style: const TextStyle(fontWeight: FontWeight.w700)),
            ]),
          ),
        const Divider(height: 18),
        Row(children: [Expanded(child: Text(qtr(context, 'subtotal'))), Text(_money(context, q['subtotalUsd'] as num, currency))]),
        if ((q['shippingUsd'] as num) > 0) Row(children: [Expanded(child: Text(qtr(context, 'shipping'))), Text(_money(context, q['shippingUsd'] as num, currency))]),
        const SizedBox(height: 6),
        Row(children: [
          Expanded(child: Text(qtr(context, 'total').replaceAll('{code}', '${currency['code']}'), style: const TextStyle(fontWeight: FontWeight.w800, fontSize: 16))),
          Text(_money(context, q['totalUsd'] as num, currency), style: TextStyle(fontWeight: FontWeight.w800, fontSize: 16, color: p.ink)),
        ]),
      ]),
      _Card(title: qtr(context, 'who_pays'), children: [
        for (final s in shares)
          Padding(
            padding: const EdgeInsets.only(bottom: 8),
            child: Row(children: [
              Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                Text('${s['payer'] == 'party' ? party['name'] : qtr(context, 'buyer')} · ${s['percent']}%', style: const TextStyle(fontWeight: FontWeight.w700)),
                Text(s['confirmed'] == true ? qtr(context, 'confirmed') : qtr(context, 'waiting'), style: TextStyle(color: s['confirmed'] == true ? const Color(0xFF0F6B49) : p.muted, fontSize: 12.5)),
              ])),
              Text(_money(context, s['amountUsd'] as num, currency)),
            ]),
          ),
      ]),
      Padding(padding: const EdgeInsets.only(bottom: 24), child: Text(qtr(context, 'not_invoice'), style: TextStyle(color: p.muted, fontSize: 12))),
    ];
  }
}
