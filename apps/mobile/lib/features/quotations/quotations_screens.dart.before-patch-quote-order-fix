                Text(s['confirmed'] == true ? qtr(context, 'confirmed') : qtr(context, 'waiting'), style: TextStyle(color: s['confirmed'] == true ? const Color(0xFF0F6B49) : p.muted, fontSize: 12.5)),
              ])),
