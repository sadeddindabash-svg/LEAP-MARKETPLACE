const _errorKey = {
  'quote_items': 'err_quote_items', 'quote_unavailable': 'err_quote_unavailable', 'quote_party': 'err_quote_party', 'quote_vehicle': 'err_quote_vehicle',
  'quote_address': 'err_quote_address', 'quote_share_total': 'err_quote_shares', 'quote_share_percent': 'err_quote_shares', 'quote_share_payer': 'err_quote_shares',
};

bool _ar(BuildContext context) => context.read<LanguageState>().isArabic;
String _lang(BuildContext context) => _ar(context) ? 'ar' : 'en';

/// The quotation texts in the app's language (used by the account menu and the basket too).
String qtr(BuildContext context, String key) => _text[key]?[_ar(context) ? 'ar' : 'en'] ?? key;

String _errorText(BuildContext context, Object e) {
  if (e is ApiException) {
    final k = e.code == null ? null : _errorKey[e.code];
    return k != null ? qtr(context, k) : e.message;
  }
  return qtr(context, 'err_generic');
}

const _arabWords = {'SAR': 'ريال', 'AED': 'درهم', 'OMR': 'ريال', 'QAR': 'ريال', 'KWD': 'دينار', 'BHD': 'دينار', 'JOD': 'دينار', 'USD': 'دولار'};

/// An amount of a quotation in its own currency, at the rate of the day it was issued, with cents: "EUR 678.18" / "2,562.00 درهم".
String _money(BuildContext context, num usd, Map<String, dynamic> currency) {
  final code = (currency['code'] as String?) ?? 'USD';
  final rate = (currency['rate'] as num?)?.toDouble() ?? 1;
  final digits = const {'KWD', 'BHD', 'OMR', 'JOD'}.contains(code) ? 3 : 2;
  final fixed = (usd.toDouble() * (rate > 0 ? rate : 1)).toStringAsFixed(digits);
  final parts = fixed.split('.');
  final whole = parts[0].replaceAllMapped(RegExp(r'\B(?=(\d{3})+(?!\d))'), (m) => ',');
  final n = '$whole.${parts[1]}';
  return _ar(context) ? '$n ${_arabWords[code] ?? code}' : '$code $n';
}

String _date(BuildContext context, String iso) {
  final d = DateTime.parse(iso).toLocal();
  const en = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const ar = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'];
  return '${d.day} ${(_ar(context) ? ar : en)[d.month - 1]} ${d.year}';
}

String _vehicleLine(Map<String, dynamic> v) => [v['make'], v['model'], v['year'], v['version']].where((x) => x != null && '$x'.isNotEmpty).join(' ');

Color _stateColor(String state) => switch (state) { 'open' => const Color(0xFF0F6B49), 'ordered' => const Color(0xFF0B3146), 'expired' => const Color(0xFFA12A21), _ => Colors.grey };
Color _stateBack(String state) => switch (state) { 'open' => const Color(0xFFE8F7EF), 'ordered' => const Color(0xFFEAF3F9), 'expired' => const Color(0xFFFDF0EF), _ => const Color(0xFFF4F6F8) };

