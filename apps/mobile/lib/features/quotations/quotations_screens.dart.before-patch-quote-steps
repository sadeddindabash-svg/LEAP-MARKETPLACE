  Map<String, dynamic>? _q;
  String? _error;
  bool _busy = false;

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) => _load());
  }

  Future<void> _load() async {
    final token = context.read<AuthState>().token;
    if (token == null) return;
    try {
      final q = await QuotationsApi().one(token, widget.quotationId, _lang(context));
      if (mounted) setState(() { _q = q; _error = null; });
    } catch (e) {
      if (mounted) setState(() => _error = _errorText(context, e));
    }
  }

  Future<void> _open(String url) async {
    await launchUrl(Uri.parse(url), mode: LaunchMode.externalApplication);
  }

  Future<void> _renew() async {
    final token = context.read<AuthState>().token;
    if (token == null) return;
    setState(() => _busy = true);
    try {
      final next = await QuotationsApi().renew(token, widget.quotationId, _lang(context), context.read<CurrencyState>().currencyCode);
      if (mounted) context.pushReplacement('/quotations/${Uri.encodeComponent(next['id'] as String)}');
    } catch (e) {
      if (mounted) setState(() { _error = _errorText(context, e); _busy = false; });
    }
