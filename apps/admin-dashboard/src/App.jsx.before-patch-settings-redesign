                      {vdFooter(g.versionCount === undefined ? "" : `${g.versionCount} ${g.versionCount === 1 ? "version" : "versions"}`, g.versionCount === 0 ? "No versions yet" : g.versionsWithoutPhoto > 0 ? `${g.versionsWithoutPhoto} without photo` : null, null)}
