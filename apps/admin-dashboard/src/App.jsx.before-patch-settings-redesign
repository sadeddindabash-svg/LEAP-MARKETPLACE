function PayoutsPage({ onSessionExpired }) {
  const [owed, setOwed] = useState([]);
  const [payoutMethods, setPayoutMethods] = useState({}); // supplierId -> payout method (or null)
  const [history, setHistory] = useState([]);
  const [loadState, setLoadState] = useState("loading");
  const [errorMessage, setErrorMessage] = useState(null);
  const [payingSupplierId, setPayingSupplierId] = useState(null);

  const load = () => {
    setLoadState("loading");
    Promise.all([fetchPayoutsOwed(getStoredToken()), fetchPayoutHistory(getStoredToken())])
      .then(async ([owedData, historyData]) => {
        setOwed(owedData);
        setHistory(historyData);
        // Real payout method per supplier currently owed (migration
        // 034) -- fetched alongside, so an admin can see (or confirm
        // the real absence of) where the money is supposed to go,
        // right next to the amount and the Record payout action.
        const methods = {};
        await Promise.all(owedData.map(async (o) => {
          try {
            methods[o.supplierId] = await fetchSupplierPayoutMethod(getStoredToken(), o.supplierId);
          } catch {
            methods[o.supplierId] = null;
          }
        }));
        setPayoutMethods(methods);
        setLoadState("ready");
      })
      .catch((err) => {
        if (err instanceof SessionExpiredError) return onSessionExpired();
        setErrorMessage(err.message);
        setLoadState("error");
      });
  };
  useEffect(load, []); // eslint-disable-line react-hooks/exhaustive-deps
  useAutoRefresh(() => Promise.all([fetchPayoutsOwed(getStoredToken()), fetchPayoutHistory(getStoredToken())]).then(([owedData, historyData]) => { setIfChanged(setOwed)(owedData); setIfChanged(setHistory)(historyData); }), { enabled: loadState === "ready" });

  const handleRecordPayout = async (supplierId) => {
    setPayingSupplierId(supplierId);
    setErrorMessage(null);
    try {
      await recordPayout(getStoredToken(), supplierId);
      load();
    } catch (err) {
      if (err instanceof SessionExpiredError) return onSessionExpired();
      setErrorMessage(err.message);
    } finally {
      setPayingSupplierId(null);
    }
  };

  const totalOwed = owed.reduce((s, o) => s + o.amountOwed, 0);

  return (
    <div>
      <TopBar title="Commission & payouts" subtitle="Recorded manually per supplier, based on each supplier's own payment agreement — no fixed platform-wide schedule" />
      <div style={{ padding: 24 }}>
        {/* patch-financial-redesign: the numbers on top */}
        {(() => {
          const since = Date.now() - 30 * 86400000;
          const paid30 = history.filter((p) => new Date(p.createdAt).getTime() >= since && p.currencyCode === "CNY").reduce((n, p) => n + Number(p.amount || 0), 0);
          const noBank = loadState === "ready" ? owed.filter((o) => !payoutMethods[o.supplierId]).length : 0;
          const tile = (label, value, sub, tone) => (
            <div key={label} style={{ background: tone === "navy" ? `linear-gradient(120deg, ${C.navyDeep}, ${C.navy} 60%, ${C.navySoft} 140%)` : tone === "red" ? C.redBg : "#fff", border: `1px solid ${tone === "navy" ? C.navy : tone === "red" ? "#EBC2BD" : C.line}`, borderRadius: 14, padding: "14px 16px", boxShadow: "0 1px 2px rgba(11,49,70,0.05)" }}>
              <div style={{ ...body, fontSize: 11, fontWeight: 800, letterSpacing: "0.06em", textTransform: "uppercase", color: tone === "navy" ? C.onNavyMuted : C.muted }}>{label}</div>
              <div style={{ ...mono, fontSize: 24, fontWeight: 800, color: tone === "navy" ? C.signal : tone === "red" ? C.redInk : C.ink, marginTop: 2 }}>{value}</div>
              {sub && <div style={{ ...body, fontSize: 11.5, color: tone === "navy" ? C.onNavyMuted : C.muted }}>{sub}</div>}
            </div>
          );
          return (
            <div style={{ display: "grid", gridTemplateColumns: "1.3fr repeat(3, minmax(0, 1fr))", gap: 12, marginBottom: 16 }}>
              {tile("Currently owed", `¥${totalOwed.toLocaleString(undefined, { minimumFractionDigits: 2 })}`, "to all suppliers, in RMB", "navy")}
              {tile("Suppliers with a balance", owed.length, owed.length ? "see the list below" : "nothing to pay now")}
              {tile("Without a bank account", noBank, noBank ? "they cannot be paid yet" : "every supplier owed has one", noBank ? "red" : null)}
              {tile("Paid in the last 30 days", `¥${paid30.toLocaleString(undefined, { minimumFractionDigits: 2 })}`, `${history.filter((p) => new Date(p.createdAt).getTime() >= since).length} payouts`)}
            </div>
          );
        })()}

        {loadState === "loading" && <Card><div style={{ padding: 32, textAlign: "center", ...body, fontSize: 13, color: C.muted }}>Loading…</div></Card>}
        {loadState === "error" && <Card><div style={{ padding: 32, textAlign: "center", ...body, fontSize: 13, color: C.red }}>Couldn't load payouts: {errorMessage}</div></Card>}
        {errorMessage && loadState === "ready" && (
          <div style={{ ...body, fontSize: 12, color: C.red, background: C.redBg, borderRadius: 8, padding: 10, marginBottom: 16 }}>{errorMessage}</div>
        )}

        {loadState === "ready" && (
          <>
            <Card
              title="Amount owed"
              style={{ marginBottom: 16 }}
              action={
                owed.length > 0 && (
                  <button
                    onClick={() => exportToExcel({
                      filename: `payouts-owed-${new Date().toISOString().slice(0, 10)}`,
                      sheetName: "Amount Owed",
                      columns: [
                        { header: "Supplier", key: "supplierName", width: 30 },
                        { header: "Amount owed", key: "amountOwed", width: 16 },
                        { header: "Eligible orders", key: "eligibleSubOrderCount", width: 16 },
                        { header: "Payout method", key: "payoutMethod", width: 40 },
                      ],
                      rows: owed.map((o) => {
                        const method = payoutMethods[o.supplierId];
                        return {
                          supplierName: o.supplierName,
                          amountOwed: o.amountOwed,
                          eligibleSubOrderCount: o.eligibleSubOrderCount,
                          payoutMethod: method ? `${method.bankName} — ${method.accountNumber} (${method.accountHolderName})` : "None on file",
                        };
                      }),
                    })}
                    style={{ ...body, display: "flex", alignItems: "center", gap: 6, padding: "6px 12px", borderRadius: 8, border: `1px solid ${C.line}`, background: "#fff", fontSize: 12, fontWeight: 700, cursor: "pointer" }}
                  >
                    <Download size={14} /> Export
                  </button>
                )
              }
            >
              {owed.length === 0 ? (
                <div style={{ padding: 24, textAlign: "center", ...body, fontSize: 13, color: C.muted }}>Nothing is currently owed to any supplier.</div>
              ) : (
                // migration 122: each supplier's payment terms, owed now, to recover, pay this time, not due yet; "Details" lists the orders
                <OwedSuppliersTable owed={owed} payoutMethods={payoutMethods} payingSupplierId={payingSupplierId} onRecord={handleRecordPayout} onSessionExpired={onSessionExpired} />
              )}
            </Card>

            <Card
              title="Payout history"
              action={
                history.length > 0 && (
                  <button
                    onClick={() => exportToExcel({
                      filename: `payout-history-${new Date().toISOString().slice(0, 10)}`,
                      sheetName: "Payout History",
                      columns: [
                        { header: "Supplier", key: "supplierName", width: 30 },
                        { header: "Amount", key: "amount", width: 14 },
                        { header: "Orders covered", key: "subOrderCount", width: 16 },
                        { header: "Date", key: "date", width: 16 },
                        { header: "Notes", key: "notes", width: 40 },
                      ],
                      rows: history.map((p) => ({
                        supplierName: p.supplierName,
                        amount: p.amount,
                        subOrderCount: p.subOrderCount,
                        date: new Date(p.createdAt).toLocaleDateString(),
                        notes: p.notes || "",
                      })),
                    })}
                    style={{ ...body, display: "flex", alignItems: "center", gap: 6, padding: "6px 12px", borderRadius: 8, border: `1px solid ${C.line}`, background: "#fff", fontSize: 12, fontWeight: 700, cursor: "pointer" }}
                  >
                    <Download size={14} /> Export
                  </button>
                )
              }
            >
              {history.length === 0 ? (
                <div style={{ padding: 24, textAlign: "center", ...body, fontSize: 13, color: C.muted }}>No payouts recorded yet.</div>
              ) : (
                <table style={{ width: "100%", borderCollapse: "collapse" }}>
                  <thead><tr><Th>Supplier</Th><Th align="right">Amount</Th><Th align="right">Orders covered</Th><Th>Date</Th><Th>Notes</Th></tr></thead>
                  <tbody>
                    {history.map((p) => (
                      <tr key={p.id}>
                        <Td style={{ fontWeight: 600 }}><span style={{ display: "inline-flex", alignItems: "center", gap: 8 }}><span aria-hidden="true" style={{ width: 28, height: 28, borderRadius: 8, background: C.navy, color: C.signal, display: "inline-flex", alignItems: "center", justifyContent: "center", fontSize: 10.5, fontWeight: 800 }}>{String(p.supplierName || "?").split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0].toUpperCase()).join("")}</span>{p.supplierName}</span></Td>
                        <Td align="right" style={{ ...mono, fontWeight: 800 }}>{p.currencyCode === "CNY" ? "¥" : "$"}{p.amount.toLocaleString(undefined, { minimumFractionDigits: 2 })}{p.currencyCode === "CNY" ? "" : " USD"}</Td>
                        <Td align="right" style={{ color: C.muted }}>{p.subOrderCount}</Td>
                        <Td style={{ color: C.muted }}>{new Date(p.createdAt).toLocaleDateString()}</Td>
                        <Td style={{ color: C.muted }}>{p.notes || "—"}</Td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
            </Card>
          </>
        )}
      </div>
    </div>
  );
}

function TicketsPage({ onOpenTicket, onSessionExpired }) {
  const [tickets, setTickets] = useState([]);
  const [loadState, setLoadState] = useState("loading");
  const [errorMessage, setErrorMessage] = useState(null);
  const priorityColor = { high: C.red, medium: C.amber, low: C.muted };
  const [filter, setFilter] = useState("all");          // the status buttons: all | open | in_progress | resolved

  useEffect(() => {
    fetchTickets(getStoredToken())
      .then((data) => { setTickets(data); setLoadState("ready"); })
      .catch((err) => {
        if (err instanceof SessionExpiredError) return onSessionExpired();
        setErrorMessage(err.message);
        setLoadState("error");
      });
  }, [onSessionExpired]);
  useAutoRefresh(() => fetchTickets(getStoredToken()).then(setIfChanged(setTickets)), { enabled: loadState === "ready" });

  const openCount = tickets.filter(t => t.status !== "resolved").length;
  // The status buttons above the table: each shows how many tickets it holds (the page refreshes itself, so the numbers follow), and the table and Export show only that status.
  const TICKET_FILTERS = [
    { id: "all", label: "All", tone: "ink" },
    { id: "open", label: "Open", tone: "red" },
    { id: "in_progress", label: "In progress", tone: "blue" },
    { id: "resolved", label: "Resolved", tone: "green" },
  ];
  const countOf = (id) => (id === "all" ? tickets.length : tickets.filter((t) => t.status === id).length);
  const shown = filter === "all" ? tickets : tickets.filter((t) => t.status === filter);
  const filterLabel = TICKET_FILTERS.find((f) => f.id === filter).label;

  return (
    <div>
      <TopBar title="Support tickets" subtitle={loadState === "ready" ? `${openCount} open · buyer ↔ platform only` : "Loading…"} />
      {/* patch-support-redesign: the numbers on top; each opens its filter */}
      {loadState === "ready" && (
        <div style={{ padding: "18px 24px 0", display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(160px, 1fr))", gap: 12 }}>
          {[
            ["open", tickets.filter((t) => t.status === "open").length, "open, waiting for you", C.redInk, C.redBg],
            ["in_progress", tickets.filter((t) => t.status === "in_progress").length, "in progress", C.torqueInk, C.torqueBg],
            ["resolved", tickets.filter((t) => t.status === "resolved").length, "resolved", C.gaugeInk, "#fff"],
            ["all", tickets.filter((t) => t.status !== "resolved" && t.priority === "high").length, "high priority, not resolved", C.amberInk, C.amberBg],
          ].map(([id, n, label, fg, bg]) => (
            <button key={label} type="button" onClick={() => setFilter(id)} style={{ ...body, textAlign: "left", background: n > 0 ? bg : "#fff", border: `1px solid ${C.line}`, borderRadius: 14, padding: "12px 16px", cursor: "pointer", boxShadow: "0 1px 2px rgba(11,49,70,0.05)" }}>
              <div style={{ ...mono, fontSize: 22, fontWeight: 800, color: n > 0 ? fg : C.ink }}>{n}</div>
              <div style={{ fontSize: 12, fontWeight: 700, color: C.muted }}>{label}</div>
            </button>
          ))}
        </div>
      )}
      <div style={{ padding: "16px 24px 0", display: "flex", justifyContent: "space-between", alignItems: "center", gap: 12, flexWrap: "wrap" }}>
        <FilterButtons label="Filter tickets by status" activeId={filter} onSelect={setFilter}
          items={TICKET_FILTERS.map((f) => ({ id: f.id, label: f.label, count: loadState === "ready" ? countOf(f.id) : "…", tone: f.tone, countTestId: `ticket-count-${f.id}` }))} />
        {/* Real export (new) -- same reusable exportToExcel() util
            already used for Orders/Suppliers/Payouts/Returns/Audit Log,
            just never added here. */}
        <button
          disabled={shown.length === 0}
          onClick={() => exportToExcel({
            filename: `support-tickets-${filter === "all" ? "" : `${filter.replace("_", "-")}-`}${new Date().toISOString().slice(0, 10)}`,
            sheetName: "Support Tickets",
            columns: [
              { header: "Ticket", key: "id", width: 14 },
              { header: "Subject", key: "subject", width: 30 },
              { header: "Buyer", key: "buyer", width: 30 },
              { header: "Order", key: "orderId", width: 16 },
              { header: "Priority", key: "priority", width: 12 },
              { header: "Status", key: "status", width: 16 },
              { header: "Updated", key: "updatedAt", width: 16 },
            ],
            rows: shown.map((t) => ({
              id: t.id, subject: t.subject, buyer: t.buyerId || t.guestEmail || "—",
              orderId: t.orderId || "—", priority: t.priority, status: t.status,
              updatedAt: new Date(t.updatedAt).toLocaleDateString(),
            })),
          })}
          style={toolbarButtonStyle(shown.length === 0)}
        >
          <Download size={13} /> Export
        </button>
      </div>
      <div style={{ padding: 24 }}>
        {loadState === "loading" && <Card><div style={{ padding: 32, textAlign: "center", ...body, fontSize: 13, color: C.muted }}>Loading tickets…</div></Card>}
        {loadState === "error" && <Card><div style={{ padding: 32, textAlign: "center", ...body, fontSize: 13, color: C.red }}>Couldn't load tickets: {errorMessage}</div></Card>}
        {loadState === "ready" && (
          <Card>
            <table style={{ width: "100%", borderCollapse: "collapse" }}>
              <thead><tr><Th>Ticket</Th><Th>Subject</Th><Th>Buyer</Th><Th>Order</Th><Th>Priority</Th><Th>Status</Th><Th>Updated</Th></tr></thead>
              <tbody>
                {shown.length === 0 && (
                  <tr><td colSpan={7} style={{ ...body, textAlign: "center", color: C.muted, fontSize: 13, padding: 32 }}>{tickets.length === 0 || filter === "all" ? "No support tickets." : `No ${filterLabel.toLowerCase()} tickets.`}</td></tr>
                )}
                {shown.map(t => (
                  <tr key={t.id} onClick={() => onOpenTicket(t.id)} style={{ cursor: "pointer" }}>
                    <Td><PlateChip small>{t.id}</PlateChip></Td>
                    <Td style={{ fontWeight: 600 }}>{t.subject}</Td>
                    <Td>{t.buyerId || t.guestEmail || "—"}</Td>
                    <Td style={{ color: C.muted }}>{t.orderId || "—"}</Td>
                    <Td><span style={{ display: "inline-flex", alignItems: "center", gap: 6, fontSize: 12, fontWeight: 800, textTransform: "capitalize", color: priorityColor[t.priority] || C.muted, background: t.priority === "high" ? C.redBg : t.priority === "medium" ? C.amberBg : "#EEEFF1", borderRadius: 999, padding: "3px 10px" }}><div style={{ width: 7, height: 7, borderRadius: "50%", background: priorityColor[t.priority] }} />{t.priority}</span></Td>
                    <Td>
                      {t.status === "open" && <Badge label="Open" color={C.red} bg={C.redBg} />}
                      {t.status === "in_progress" && <Badge label="In progress" color={C.torque} bg={C.torqueBg} />}
                      {t.status === "resolved" && <Badge label="Resolved" color={C.gauge} bg={C.gaugeBg} />}
                    </Td>
                    <Td style={{ color: C.muted }}>{new Date(t.updatedAt).toLocaleString()}</Td>
                  </tr>
                ))}
              </tbody>
            </table>
          </Card>
        )}
      </div>
    </div>
  );
}

function TicketDetailPage({ ticketId, onBack, onSessionExpired }) {
  const [ticket, setTicket] = useState(null);
  const [loadState, setLoadState] = useState("loading");
  const [errorMessage, setErrorMessage] = useState(null);
  const [replyText, setReplyText] = useState("");
  const [isSending, setIsSending] = useState(false);

  const load = () => {
    fetchTicketById(getStoredToken(), ticketId)
      .then((data) => { setTicket(data); setLoadState("ready"); })
      .catch((err) => {
