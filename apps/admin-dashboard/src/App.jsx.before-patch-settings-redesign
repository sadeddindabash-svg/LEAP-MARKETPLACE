            </div>
            {formError && <div style={{ ...body, fontSize: 12.5, color: C.red, marginBottom: 12 }}>{formError}</div>}

            <table style={{ width: "100%", borderCollapse: "collapse" }}>
              <thead>
                <tr>
                  <Th>Brand</Th>
                  <Th>Model</Th>
                  <Th>Years</Th>
                  <Th>Discount</Th>
                  <Th>From</Th>
                  <Th>To</Th>
                  <Th>Countdown</Th>
                  <Th>Status</Th>
                  <Th></Th>
                </tr>
              </thead>
              <tbody>
                {rules.length === 0 && (
                  <tr><td colSpan={9} style={{ ...body, fontSize: 13, color: C.muted, padding: "13px 16px" }}>No discount rules yet.</td></tr>
