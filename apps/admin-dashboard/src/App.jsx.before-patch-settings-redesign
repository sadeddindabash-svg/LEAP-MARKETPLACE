const menuInitials = (user) => (user.name || user.email || "A").split(/[\s@.]+/).filter(Boolean).slice(0, 2).map((w) => w[0].toUpperCase()).join("") || "A";

function AdminDashboardShell({ currentUser, onLogout }) {
  const hasAccess = (id) => currentUser.isOwner || currentUser.allowedPages === 'all' || (currentUser.allowedPages || []).includes(id);
  const [page, setPage] = useState(() => {
    if (hasAccess('overview')) return 'overview';
    const firstAllowed = NAV.find((n) => hasAccess(n.id));
    return firstAllowed ? firstAllowed.id : 'overview';
  });
  const [openOrder, setOpenOrder] = useState(null);
  const [openTicket, setOpenTicket] = useState(null);
  const [messageSupplier, setMessageSupplier] = useState(null); // {supplierId, supplierName} -- confirmed with the person, for the order detail page's "Message supplier(s)" action
  const [openCase, setOpenCase] = useState(null);
  // Real supplier detail deep-link (new) -- lifted to the shell the
  // same way orders/tickets/cases already are, so GlobalSearch's
  // supplier results (and a real row-click on SuppliersPage itself)
  // can navigate directly to one specific supplier, not just the
  // whole Suppliers list page.
  const [openSupplier, setOpenSupplier] = useState(null);
  const [flaggedCount, setFlaggedCount] = useState(0);
  const [navCounts, setNavCounts] = useState(null);      // what is waiting, per page (GET /admin-counts)
  // The tab each group was last on (clicking the group in the sidebar returns to it). Kept up to date by ANY navigation: the sidebar, a tab, the bell, search, a link.
  const [lastTabByGroup, setLastTabByGroup] = useState({});
  const [productsView, setProductsView] = useState("all");
  // The side menu can be collapsed to icons only; the choice is remembered in this browser.
  const [menuCollapsed, setMenuCollapsed] = useState(() => { try { return localStorage.getItem("leap_admin_menu_collapsed") === "1"; } catch { return false; } });
  const toggleMenu = () => setMenuCollapsed((v) => { const next = !v; try { localStorage.setItem("leap_admin_menu_collapsed", next ? "1" : "0"); } catch { /* not kept: fine */ } return next; });      // Products > All products | Live products | Hidden products | Product requirements (one page, four tabs)
  useEffect(() => {
    const group = groupOfPage(page);
    if (group) setLastTabByGroup((previous) => (previous[group.id] === page ? previous : { ...previous, [group.id]: page }));
  }, [page]);
  // Real notification bell (new) -- closes a real gap: the Bell icon
  // in TopBar was 100% decorative before this, no badge, no click
  // handler, nothing. Reuses the SAME real aggregate counts the
  // Overview page already computes (GET /overview) -- no new backend
  // endpoint needed, since pendingSuppliers/openDisputes/
  // pendingModeration/openTickets were already real and already
  // correct, just never surfaced anywhere except that one page.
  const [pendingCounts, setPendingCounts] = useState({ pendingSuppliers: 0, openDisputes: 0, pendingModeration: 0, openTickets: 0, shippingCostsWaiting: 0 });

  useEffect(() => {
    fetchFlaggedShipments(getStoredToken())
      .then((data) => setFlaggedCount(data.length))
      .catch(() => {}); // non-critical -- the sidebar badge just stays at 0 rather than breaking the shell
    fetchAdminCounts(getStoredToken()).then((c) => setNavCounts((cur) => (sameData(cur, c) ? cur : c))).catch(() => {});      // the side menu's numbers
    fetchOverview(getStoredToken())
      .then((data) => setPendingCounts({
        pendingSuppliers: data.pendingSuppliers, openDisputes: data.openDisputes,
        pendingModeration: data.pendingModeration, openTickets: data.openTickets, shippingCostsWaiting: data.shippingCostsWaiting || 0,
      }))
      .catch(() => {}); // non-critical -- the bell badge just stays at 0 rather than breaking the shell
  }, [page]); // refetch whenever navigating, so acting on something reflects in the badge soon after
  // the side menu's numbers (and the group tabs'), every few seconds
  useAutoRefresh(() => fetchAdminCounts(getStoredToken()).then((c) => setNavCounts((cur) => (sameData(cur, c) ? cur : c))));
  // The sidebar badges (flagged shipments, pending suppliers, disputes, moderation, tickets) follow the platform by themselves.
  useAutoRefresh(() => Promise.all([
    fetchFlaggedShipments(getStoredToken()).then((data) => setFlaggedCount(data.length)),
    fetchOverview(getStoredToken()).then((data) => setPendingCounts({ pendingSuppliers: data.pendingSuppliers, openDisputes: data.openDisputes, pendingModeration: data.pendingModeration, openTickets: data.openTickets, shippingCostsWaiting: data.shippingCostsWaiting || 0 })),
  ]));

  let content;
  if (openOrder) content = <OrderDetailPage orderId={openOrder} onBack={() => setOpenOrder(null)} onSessionExpired={onLogout}
    onOpenTicket={(ticketId) => { setOpenOrder(null); setOpenTicket(ticketId); }}
    onOpenSupplierMessages={(supplierId, supplierName) => { setOpenOrder(null); setMessageSupplier({ supplierId, supplierName }); setPage("supplierMessages"); }}
  />;
  else if (openTicket) content = <TicketDetailPage ticketId={openTicket} onBack={() => setOpenTicket(null)} onSessionExpired={onLogout} />;
  else if (openCase) content = <ReturnCaseDetailPage caseId={openCase} onBack={() => setOpenCase(null)} onSessionExpired={onLogout} />;
  else if (openSupplier) content = <SupplierDetailPage supplierId={openSupplier} onBack={() => setOpenSupplier(null)} onSessionExpired={onLogout} />;
  else if (page === "overview") content = <OverviewPage onSessionExpired={onLogout} />;
  else if (page === "orders") content = <OrdersPage onOpenOrder={setOpenOrder} onSessionExpired={onLogout} />;
  else if (page === "suppliers") content = <SuppliersPage onOpenSupplier={setOpenSupplier} onSessionExpired={onLogout} />;
  else if (page === "moderation") content = <ModerationPage onSessionExpired={onLogout} />;
  else if (page === "allProducts") content = <AllProductsPage view={productsView} onSessionExpired={onLogout} />;
  else if (page === "returns") content = <ReturnsPage onOpenCase={setOpenCase} onSessionExpired={onLogout} />;
  else if (page === "vehicleData") content = <VehicleDataPage onSessionExpired={onLogout} />;
  else if (page === "deliveryRules") content = <DeliveryRulesPage onSessionExpired={onLogout} />;
  else if (page === "categories") content = <CategoriesPage onSessionExpired={onLogout} />;
  else if (page === "supplierMessages") content = <SupplierMessagesPage onSessionExpired={onLogout} initialSupplier={messageSupplier} />;
  else if (page === "promoCodes") content = <PromoCodesPage onSessionExpired={onLogout} />;
  else if (page === "hubs") content = <HubsPage onSessionExpired={onLogout} />;
  else if (page === "pricing") content = <PricingPage onSessionExpired={onLogout} />;
  else if (page === "paymentMethods") content = <PaymentMethodsPage onSessionExpired={onLogout} />;
  else if (page === "paymentProviders") content = <PaymentProvidersPage onSessionExpired={onLogout} />;
  else if (page === "flagged") content = <FlaggedShipmentsPage onOpenOrder={setOpenOrder} onSessionExpired={onLogout} onCountChange={setFlaggedCount} />;
  else if (page === "payouts") content = <PayoutsPage onSessionExpired={onLogout} />;
  else if (page === "profits") content = <div><TopBar title="Profits" subtitle="What Leap keeps after paying the suppliers. A part of an order counts once its return window ends, when the money is final." /><ProfitsPanel onSessionExpired={onLogout} /></div>;
  else if (page === "shippingCosts") content = <div><TopBar title="Shipping costs" subtitle="What every parcel really cost to ship, as the hubs entered it, against the shipping inside its prices. Only admins see these amounts." /><ShippingCostsPanel onSessionExpired={onLogout} /></div>;
  else if (page === "reviews") content = <ReviewsPage onSessionExpired={onLogout} />;
  else if (page === "tickets") content = <TicketsPage onOpenTicket={setOpenTicket} onSessionExpired={onLogout} />;
  else if (page === "settings") content = <SettingsPage currentUser={currentUser} onSessionExpired={onLogout} />;

  // The sub-tabs of the current page's group, only the pages this admin may open, and not while an order / ticket / case / supplier detail is showing.
  const tabGroup = !openOrder && !openTicket && !openCase && !openSupplier ? groupOfPage(page) : null;
  const tabIds = tabGroup ? accessibleChildren(tabGroup, hasAccess) : [];
  // The tabs under every page's header: its group's pages; Products: All products, Moderation, Live products, Hidden products, Product requirements
  // (the "All products" page shows four of them); a page outside any group: one tab, its own name (a page with tabs of its own shows those instead).
  const detailOpen = Boolean(openOrder || openTicket || openCase || openSupplier);
  let pageTabs = null;
  if (!detailOpen && tabGroup && tabGroup.id === "group:products") {
    const canAll = hasAccess("allProducts");
    const list = [];
    if (canAll) list.push({ id: "allProducts", label: "All products" });
    if (hasAccess("moderation")) list.push({ id: "moderation", label: "Moderation" });
    if (canAll) list.push({ id: "allProducts:live", label: "Live products" }, { id: "allProducts:hidden", label: "Hidden products" }, { id: "allProducts:requirements", label: "Product requirements" });
    pageTabs = { label: tabGroup.label, tabs: list, activeId: page === "allProducts" && productsView !== "all" ? `allProducts:${productsView}` : page,
      onSelect: (id) => { const [p, v] = id.split(":"); setPage(p); if (p === "allProducts") setProductsView(v || "all"); setMessageSupplier(null); } };
  } else if (!detailOpen && tabGroup) {
    pageTabs = { label: tabGroup.label, tabs: tabIds.map((id) => ({ id, label: TAB_LABELS[id], ...tabBadge(navCounts, id, { flaggedCount }) })), activeId: page, onSelect: (id) => { setPage(id); setMessageSupplier(null); } };
  } else if (!detailOpen) {
    const own = NAV.find((n) => n.id === page);
    if (own) pageTabs = { label: own.label, tabs: [{ id: page, label: own.label }], activeId: page, onSelect: () => {}, single: true };
  }

  // the side menu's highlight slides to the item clicked, and the new page fades in
  const menuBoxRef = useRef(null);
  const pageBoxRef = useRef(null);
  const menuMark = useSlidingMark(menuBoxRef, '.leap-menu-item[aria-current="page"]', [page, Boolean(openOrder), Boolean(openTicket), Boolean(openCase), menuCollapsed]);
  const menuSlides = Boolean(menuMark && menuMark.h);
  const shownPage = useRef(null);
  const pageKey = `${page}|${Boolean(openOrder)}|${Boolean(openTicket)}|${Boolean(openCase)}|${Boolean(openSupplier)}`;
  useLayoutEffect(() => {
    const was = shownPage.current;
    shownPage.current = pageKey;
    if (was === null || was === pageKey || lessMotion() || !pageBoxRef.current || typeof pageBoxRef.current.animate !== "function") return;
    pageBoxRef.current.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 240, easing: "ease-out" });
  }, [pageKey]);

  return (
    <CurrentUserContext.Provider value={currentUser}>
    <NavigationContext.Provider value={{
      onOpenOrder: setOpenOrder,
      onOpenTicket: setOpenTicket,
      onOpenCase: setOpenCase,
      onOpenSupplier: setOpenSupplier,
      onNavigateToPage: (p) => { setPage(p); setOpenOrder(null); setOpenTicket(null); setOpenCase(null); setOpenSupplier(null); setMessageSupplier(null); },
      pendingCounts,
      flaggedCount,
    }}>
    <div style={{ display: "flex", height: "100%", minHeight: 700, background: MENU.bg, ...body }}>
      <style>{FONT_IMPORT}</style>
      <style>{`tbody tr:hover { background: ${C.surfaceHigh}; }`}</style>
      <style>{PAGE_CSS}</style>
      <style>{MENU_CSS}</style>
      {/* the menu stays in view while a long page scrolls, so the name and Log out at its bottom are always there */}
      <nav aria-label="Main menu" style={{ width: menuCollapsed ? MENU.collapsed : MENU.expanded, transition: "width 160ms ease", background: MENU.bg, display: "flex", flexDirection: "column", flexShrink: 0, position: "sticky", top: 0, height: "100vh", minHeight: 600, alignSelf: "flex-start", zIndex: 5 }}>
        <div style={menuCollapsed ? { display: "flex", flexDirection: "column", alignItems: "center", gap: 10, padding: "16px 0 10px" } : { display: "flex", alignItems: "center", justifyContent: "space-between", gap: 8, padding: "16px 12px 10px 18px" }}>
          {/* the company: logo, name, and which portal this is */}
          {menuCollapsed
            ? <BrandLogo size={36} label={"Leap Auto Parts"} />
            : <div style={{ display: "flex", alignItems: "center", gap: 9, minWidth: 0 }}>
                <BrandLogo size={36} />
                <div style={{ minWidth: 0, lineHeight: 1.15 }}>
                  <div style={{ ...body, fontSize: 14.5, fontWeight: 800, color: MENU.strong, whiteSpace: "nowrap" }}>Leap Auto Parts</div>
                  <div style={{ ...body, fontSize: 10.5, fontWeight: 800, color: C.signal, marginTop: 3, letterSpacing: "0.1em", textTransform: "uppercase", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>{"Admin portal"}</div>
                </div>
              </div>}
          <button type="button" onClick={toggleMenu} aria-label={menuCollapsed ? "Expand the menu" : "Collapse the menu"} aria-expanded={!menuCollapsed} title={menuCollapsed ? "Expand the menu" : "Collapse the menu"}
            style={{ width: 36, height: 36, borderRadius: 10, border: `1px solid ${MENU.line}`, background: "transparent", color: MENU.text, display: "flex", alignItems: "center", justifyContent: "center", cursor: "pointer", flexShrink: 0 }}>
            {menuCollapsed ? <ChevronRight size={16} /> : <ChevronLeft size={16} />}
          </button>
        </div>
        <div ref={menuBoxRef} className="leap-menu-box" style={{ flex: 1, padding: "6px 12px", position: "relative", overflowY: "auto", overflowX: "hidden", scrollbarWidth: "none", msOverflowStyle: "none" }}>
          {/* the chosen item's background (with its curved corners): one shape that slides to the item clicked (drawn first, so the items sit on it) */}
          {menuMark && (
            <span aria-hidden="true" data-testid="menu-highlight" style={{
              position: "absolute", left: menuMark.x, right: 12, top: 0, height: menuMark.h, transform: `translateY(${menuMark.y}px)`, pointerEvents: "none",
              background: MENU.activeBg, borderRadius: 8, boxShadow: `inset 4px 0 0 ${C.signal}`, transition: menuMark.anim ? `transform ${SLIDE_MS}ms ${SLIDE_EASE}` : "none",
            }}>
              <span className="leap-menu-curve top" />
              <span className="leap-menu-curve bottom" />
            </span>
          )}
          {sidebarEntries(NAV, hasAccess).map((entry, entryIndex, allEntries) => {
            // A group (Suppliers, Products, Support, Financial) is ONE sidebar entry; everything else is a page, as before.
            const isGroup = entry.type === "group";
            const n = isGroup ? { id: entry.group.id, label: entry.group.label, icon: GROUP_ICONS[entry.group.id] } : entry.page;
            const Icon = n.icon;
            const active = (isGroup ? entry.group.children.includes(page) : page === n.id) && !openOrder && !openTicket && !openCase;
            const open = () => {
              setPage(isGroup ? landingPage(entry.group, hasAccess, lastTabByGroup[entry.group.id]) : n.id);
              setOpenOrder(null); setOpenTicket(null); setOpenCase(null); setOpenSupplier(null); setMessageSupplier(null);
            };
            // the number: what is waiting on this page, or (a group) on its pages this admin may open; red when it holds something up
            const badge = menuBadge(navCounts, isGroup ? accessibleChildren(entry.group, hasAccess) : [n.id], { flaggedCount });
            const section = MENU_SECTIONS[n.id];
            const newSection = section && (entryIndex === 0 || MENU_SECTIONS[entryId(allEntries[entryIndex - 1])] !== section);
            const sectionHead = !newSection ? null : menuCollapsed
              ? (entryIndex > 0 ? <div key={`section:${section}`} aria-hidden="true" style={{ height: 1, background: MENU.line, margin: "8px 10px" }} /> : null)
              : <div key={`section:${section}`} style={{ ...body, padding: entryIndex === 0 ? "4px 10px 6px" : "14px 10px 6px", fontSize: 10.5, fontWeight: 700, letterSpacing: "0.1em", textTransform: "uppercase", color: MENU.soft }}>{section}</div>;
            const count = badge.count;
            return [sectionHead, (
              <button key={n.id} onClick={open} className="leap-menu-item" aria-current={active ? "page" : undefined} aria-label={menuCollapsed ? n.label : undefined} style={{
                position: "relative", width: "100%", display: "flex", alignItems: "center", justifyContent: menuCollapsed ? "center" : "flex-start", gap: 12, height: 40,
                padding: menuCollapsed ? 0 : "0 10px", margin: "1px 0", borderRadius: 8, border: "none", cursor: "pointer", textAlign: "left",
                background: active && !menuSlides ? MENU.activeBg : "transparent", boxShadow: active && !menuSlides ? `inset 4px 0 0 ${C.signal}` : "none", color: active ? MENU.activeText : MENU.text, transition: "color 200ms ease",
              }}>
                {/* the curved corners above and below the chosen item: it flows into the page (drawn by the sliding shape once it is in place) */}
                {active && !menuSlides && <span aria-hidden="true" className="leap-menu-curve top" />}
                {active && !menuSlides && <span aria-hidden="true" className="leap-menu-curve bottom" />}
                <span style={{ display: "inline-flex", color: active ? MENU.activeIcon : "inherit", position: "relative" }}>
                  <Icon size={18} />
                  {menuCollapsed && count > 0 && <span style={{ position: "absolute", top: -7, right: -10, minWidth: 16, height: 16, borderRadius: 999, background: badge.red ? C.red : MENU.badge, color: badge.red ? "#fff" : MENU.badgeText, fontSize: 10, fontWeight: 800, display: "flex", alignItems: "center", justifyContent: "center", padding: "0 4px", boxSizing: "border-box" }}>{count}</span>}
                </span>
                {!menuCollapsed && <span style={{ ...body, fontSize: 13, fontWeight: active ? 700 : 500, flex: 1, whiteSpace: "nowrap" }}>{n.label}</span>}
                {!menuCollapsed && count > 0 && (
                  <span title={badge.tip} aria-label={badge.tip} style={{ ...body, fontSize: 10.5, fontWeight: 800, color: badge.red ? "#fff" : MENU.badgeText, background: badge.red ? C.red : MENU.badge, borderRadius: 10, padding: "1px 7px", minWidth: 18, textAlign: "center" }}>
                    {count}
                  </span>
                )}
                {menuCollapsed && <span role="tooltip" className="leap-menu-tip">{badge.tip ? `${n.label} · ${badge.tip}` : n.label}</span>}
              </button>
            )];
          })}
        </div>
        {menuCollapsed ? (
          <div style={{ display: "flex", flexDirection: "column", alignItems: "center", gap: 10, padding: "14px 0", borderTop: `1px solid ${MENU.line}` }}>
            <span title={currentUser.name || currentUser.email} style={{ width: 36, height: 36, borderRadius: "50%", background: MENU.activeBg, color: C.signal, display: "flex", alignItems: "center", justifyContent: "center", ...body, fontSize: 12, fontWeight: 800 }}>{menuInitials(currentUser)}</span>
            <button type="button" onClick={onLogout} aria-label="Log out" title="Log out" style={{ width: 36, height: 36, borderRadius: 10, border: `1px solid ${MENU.line}`, background: "transparent", color: MENU.text, display: "flex", alignItems: "center", justifyContent: "center", cursor: "pointer" }}>
              <LogOut size={16} />
            </button>
          </div>
        ) : (
          <div style={{ padding: "12px 16px 14px 24px", borderTop: `1px solid ${MENU.line}` }}>
            <div style={{ ...body, fontSize: 12.5, color: MENU.strong, fontWeight: 700, marginBottom: 2 }}>{currentUser.name || currentUser.email}</div>
            <div style={{ ...body, fontSize: 11, color: MENU.soft, marginBottom: 10 }}>{currentUser.email}</div>
            <button onClick={onLogout} style={{
              width: "100%", display: "flex", alignItems: "center", justifyContent: "center", gap: 6, height: 36,
              borderRadius: 10, border: `1px solid ${MENU.line}`, background: "transparent", color: MENU.text, fontSize: 12, fontWeight: 700, cursor: "pointer",
            }}>
              <LogOut size={13} /> Log out
            </button>
          </div>
        )}
      </nav>
      <main style={{ flex: 1, minWidth: 0, display: "flex", background: PANEL.bg }}>
        <div style={{ flex: 1, minWidth: 0, overflowY: "auto", padding: PANEL.inset }}>
          <div ref={pageBoxRef} data-leap-page="" style={{ minHeight: "100%", boxSizing: "border-box", background: C.canvas, border: `1px solid ${C.line}`, borderRadius: PANEL.boxRadius, overflow: "hidden", borderWidth: PANEL.inset ? 1 : 0 }}>
            {/* the group's tabs go to the page's header, which shows them UNDER the title (the common page design) */}
            <PageTabsContext.Provider value={pageTabs}>
              {content}
            </PageTabsContext.Provider>
          </div>
        </div>
      </main>
    </div>
    </NavigationContext.Provider>
    </CurrentUserContext.Provider>
  );
}

/**
 * Auth gate — checks for a saved session on load (verifying the token is
 * still valid via GET /auth/me, not just trusting whatever's in
 * localStorage), shows LoginPage if not authenticated or not an admin
 * role, otherwise renders the real dashboard.
 */
export default function LeapAdminApp() {
  const [authState, setAuthState] = useState({ status: "checking", user: null });

  useEffect(() => {
    const token = getStoredToken();
    if (!token) {
      setAuthState({ status: "loggedOut", user: null });
      return;
    }
    getCurrentUser(token)
      .then((user) => setAuthState({ status: "loggedIn", user }))
      .catch(() => {
        // Saved token is expired/invalid — don't leave the app stuck
        // thinking it's logged in when every real request would 401.
        clearToken();
        setAuthState({ status: "loggedOut", user: null });
      });
  }, []);

  const handleLoginSuccess = (token, user) => {
    saveToken(token);
    setAuthState({ status: "loggedIn", user });
  };

  const handleLogout = () => {
    clearToken();
    setAuthState({ status: "loggedOut", user: null });
  };

  if (authState.status === "checking") {
    return (
      <>
        <style>{FONT_IMPORT}</style>
        <div style={{ display: "flex", alignItems: "center", justifyContent: "center", minHeight: 700, ...body, color: "#6B7280", fontSize: 13 }}>
          Checking session…
        </div>
      </>
    );
  }
  if (authState.status === "loggedOut") {
    return <LoginPage onLoginSuccess={handleLoginSuccess} />;
  }
  return <AdminDashboardShell currentUser={authState.user} onLogout={handleLogout} />;
}
