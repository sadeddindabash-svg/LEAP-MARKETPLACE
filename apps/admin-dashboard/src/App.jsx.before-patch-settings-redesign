                          <span key={v.id} style={{ ...body, display: "inline-flex", alignItems: "center", gap: 4, fontSize: 11.5, fontWeight: 700, color: C.torqueInk, background: C.torqueBg, borderRadius: 999, padding: "2px 3px 2px 8px" }}>
