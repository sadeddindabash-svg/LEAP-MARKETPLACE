      <div style={{ ...body, fontSize: 12, fontWeight: 800, color: C.ink, marginBottom: 8 }}>Waiting for the supplier's answer{subOrder.timesSent > 1 ? ` · sent ${ordinal(subOrder.timesSent)} time` : ""}</div>
