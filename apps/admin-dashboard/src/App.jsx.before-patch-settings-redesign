// Vehicle Data adds a vehicle in three steps and asks for only this:
//   Brand : English name + Arabic name + photo, all required
//   Model : English name + Arabic name, nothing else (no photo)
//   Year  : the year in English digits + photo, both required (a year entry is stored as a one-year "generation": its name is the year)
// Engines and transmissions are no longer part of adding a vehicle (existing ones stay in the database untouched). Years that were created the older way
// (a name like "F20" with a range of years) keep working: they are listed with an "Older entry" mark and can still be edited, deleted and given a photo.
const OLDEST_YEAR = 1950;
const toEnglishDigits = (text) => String(text ?? "")
  .replace(/[\u0660-\u0669]/g, (d) => String(d.charCodeAt(0) - 0x0660))   // Arabic-Indic digits
  .replace(/[\u06F0-\u06F9]/g, (d) => String(d.charCodeAt(0) - 0x06F0));   // Persian digits
// A year entry made through Vehicle Data: one year, named by it.
const isSingleYearEntry = (g) => g.yearEnd === g.yearStart && String(g.name).trim() === String(g.yearStart);

function VehicleDataPage({ onSessionExpired }) {
  const [activeTab, setActiveTab] = useState("brands");
  const VEHICLE_TABS = [["brands", "Brands"], ["import", "Import from Excel"], ["export", "Download Excel"], ["wmi", "VIN WMI"], ["patterns", "VIN model patterns"]];      // the page's main tabs, under its header
  const [brands, setBrands] = useState([]);
  const [selectedBrand, setSelectedBrand] = useState(null);
  const [models, setModels] = useState([]);
  const [selectedModel, setSelectedModel] = useState(null);
  const [years, setYears] = useState([]);
  // patch-vehicle-data-redesign
  const [selectedYearEntry, setSelectedYearEntry] = useState(null);      // the year whose versions are open (step 4)
  const [modelsLoaded, setModelsLoaded] = useState(false);
  const [yearsLoaded, setYearsLoaded] = useState(false);
  const [vdQuery, setVdQuery] = useState("");
  const [vdAddOpen, setVdAddOpen] = useState(false);
  const [vdMenuKey, setVdMenuKey] = useState(null);
  useEffect(() => {
    if (vdMenuKey === null) return undefined;
    const onDown = (e) => { if (!(e.target.closest && e.target.closest("[data-vd-menu]"))) setVdMenuKey(null); };
    const onKey = (e) => { if (e.key === "Escape") setVdMenuKey(null); };
    document.addEventListener("mousedown", onDown); document.addEventListener("keydown", onKey);
    return () => { document.removeEventListener("mousedown", onDown); document.removeEventListener("keydown", onKey); };
  }, [vdMenuKey]);

  const [loadState, setLoadState] = useState("loading");
  const [errorMessage, setErrorMessage] = useState(null);
  const [isSubmitting, setIsSubmitting] = useState(false);
  // Brand: English name, Arabic name, Chinese name, photo (all required)
  const [newBrandName, setNewBrandName] = useState("");
  const [newBrandNameAr, setNewBrandNameAr] = useState("");
  const [newBrandNameZh, setNewBrandNameZh] = useState("");
  const [newBrandPhotoFile, setNewBrandPhotoFile] = useState(null);
  const [newBrandPhotoPreview, setNewBrandPhotoPreview] = useState(null);
  const [isUploadingBrandPhoto, setIsUploadingBrandPhoto] = useState(false);
  const [replacingBrandPhotoId, setReplacingBrandPhotoId] = useState(null);
  // Model: English name, Arabic name (nothing else)
  const [newModelName, setNewModelName] = useState("");
  const [newModelNameAr, setNewModelNameAr] = useState("");
  const [newModelNameZh, setNewModelNameZh] = useState("");
  // Year: the year (English digits) and a photo, both required
  const [newYear, setNewYear] = useState("");
  const [newYearPhotoFile, setNewYearPhotoFile] = useState(null);
  const [newYearPhotoPreview, setNewYearPhotoPreview] = useState(null);
  const [isUploadingYearPhoto, setIsUploadingYearPhoto] = useState(false);
  const [replacingYearPhotoId, setReplacingYearPhotoId] = useState(null);
  const [pendingDelete, setPendingDelete] = useState(null); // {kind, id, label}
  const [pendingEdit, setPendingEdit] = useState(null); // {kind, item}
  const [isSavingEdit, setIsSavingEdit] = useState(false);

  const loadBrands = () => {
    setLoadState("loading");
    fetchBrands().then((b) => { setBrands(b); setLoadState("ready"); }).catch((e) => { setErrorMessage(e.message); setLoadState("error"); });
  };
  useEffect(loadBrands, []);

  const openBrand = (brand) => {
    setSelectedBrand(brand); setSelectedModel(null); setSelectedYearEntry(null); setVdAddOpen(false); setVdQuery("");
    setNewModelName(""); setNewModelNameAr(""); setNewModelNameZh(""); setErrorMessage(null);
    setModelsLoaded(false);
    fetchModelsForBrand(brand.id).then((m) => { setModels(m); setModelsLoaded(true); }).catch((e) => setErrorMessage(e.message));
  };
  // stay = true: only reload the years (a version was added or removed on the Versions page)
  const openModel = (model, stay = false) => {
    setSelectedModel(model);
    if (!stay) { setSelectedYearEntry(null); setVdAddOpen(false); setVdQuery(""); setNewYear(""); setErrorMessage(null); setYearsLoaded(false); }
    fetchGenerationsForModel(model.id).then((y) => { setYears(y); setYearsLoaded(true); }).catch((e) => setErrorMessage(e.message));
  };
  const openYear = (g) => { setSelectedYearEntry(g); setVdAddOpen(false); setErrorMessage(null); };
  const backToBrands = () => { setSelectedBrand(null); setSelectedModel(null); setSelectedYearEntry(null); setVdAddOpen(false); setVdQuery(""); setErrorMessage(null); loadBrands(); };
  const backToModels = () => { if (selectedBrand) openBrand(selectedBrand); };
  const backToYears = () => { if (selectedModel) openModel(selectedModel); };

  const handleBrandPhotoSelect = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setNewBrandPhotoFile(file);
    setNewBrandPhotoPreview(URL.createObjectURL(file));
    setErrorMessage(null);
  };
  const handleYearPhotoSelect = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setNewYearPhotoFile(file);
    setNewYearPhotoPreview(URL.createObjectURL(file));
    setErrorMessage(null);
  };

  // Each step checks only what it asks for, then uploads the photo FIRST (so a failed upload is caught before anything is created).
  const handleAddBrand = async () => {
    if (!newBrandName.trim()) { setErrorMessage("English name is required."); return; }
    if (!newBrandNameAr.trim()) { setErrorMessage("Arabic name is required."); return; }
    if (!newBrandNameZh.trim()) { setErrorMessage("Chinese name is required."); return; }
    if (!newBrandPhotoFile) { setErrorMessage("A photo is required."); return; }
    setIsSubmitting(true); setErrorMessage(null);
    try {
      const token = getStoredToken();
      setIsUploadingBrandPhoto(true);
      const upload = await uploadCatalogImage(token, newBrandPhotoFile);
      setIsUploadingBrandPhoto(false);
      await createBrand(token, newBrandName.trim(), newBrandNameAr.trim(), upload.url, newBrandNameZh.trim());
      loadBrands(); setVdAddOpen(false);
      setNewBrandName(""); setNewBrandNameAr(""); setNewBrandNameZh(""); setNewBrandPhotoFile(null); setNewBrandPhotoPreview(null);
    } catch (err) {
      if (err instanceof SessionExpiredError) return onSessionExpired();
      setErrorMessage(err.message);
    } finally { setIsSubmitting(false); setIsUploadingBrandPhoto(false); }
  };

  const handleAddModel = async () => {
    if (!newModelName.trim()) { setErrorMessage("English name is required."); return; }
    if (!newModelNameAr.trim()) { setErrorMessage("Arabic name is required."); return; }
    if (!newModelNameZh.trim()) { setErrorMessage("Chinese name is required."); return; }
    setIsSubmitting(true); setErrorMessage(null);
    try {
      await createModel(getStoredToken(), selectedBrand.id, newModelName.trim(), newModelNameAr.trim(), newModelNameZh.trim());
      openBrand(selectedBrand);
    } catch (err) {
      if (err instanceof SessionExpiredError) return onSessionExpired();
      setErrorMessage(err.message);
    } finally { setIsSubmitting(false); }
  };

  const handleAddYear = async () => {
    const year = toEnglishDigits(newYear).trim();
    const newest = new Date().getFullYear() + 1;
    if (!year) { setErrorMessage("Year is required."); return; }
    if (!/^\d{4}$/.test(year)) { setErrorMessage("Write the year as four digits, for example 2021."); return; }
    if (Number(year) < OLDEST_YEAR || Number(year) > newest) { setErrorMessage(`The year must be between ${OLDEST_YEAR} and ${newest}.`); return; }
    setIsSubmitting(true); setErrorMessage(null);
    try {
      const token = getStoredToken();
      await createYear(token, selectedModel.id, Number(year));            // the year only: the photos belong to its versions
      setNewYear(""); setNewYearPhotoFile(null); setNewYearPhotoPreview(null);
      openModel(selectedModel);
    } catch (err) {
      if (err instanceof SessionExpiredError) return onSessionExpired();
      setErrorMessage(err.message);   // e.g. "2021 already exists for this model"
    } finally { setIsSubmitting(false); setIsUploadingYearPhoto(false); }
  };

  const handleDelete = async (kind, id) => {
    try {
      const token = getStoredToken();
      if (kind === "brand") { await deleteBrand(token, id); loadBrands(); }
      else if (kind === "model") { await deleteModel(token, id); openBrand(selectedBrand); }
      else if (kind === "generation") { await deleteGeneration(token, id); openModel(selectedModel); }
    } catch (err) {
      if (err instanceof SessionExpiredError) return onSessionExpired();
      setErrorMessage(err.message); // e.g. the real 409 "products reference this" message
    } finally {
      setPendingDelete(null);
    }
  };

  // Brands and models can be reordered; years are always listed newest first.
  const handleMove = async (kind, id, direction) => {
    try {
      const token = getStoredToken();
      const keep = (fresh, prev) => fresh.map((f) => ({ ...(prev.find((p) => p.id === f.id) || {}), ...f }));      // the move answer has no counts (nor the Chinese name)
      if (kind === "brand") { const fresh = await moveBrand(token, id, direction); setBrands((prev) => keep(fresh, prev)); }
      else if (kind === "model") { const fresh = await moveModel(token, id, direction); setModels((prev) => keep(fresh, prev)); }
    } catch (err) {
      if (err instanceof SessionExpiredError) return onSessionExpired();
      setErrorMessage(err.message);
    }
  };

  const handleSaveEdit = async (values) => {
    const { kind, item } = pendingEdit;
    setIsSavingEdit(true);
    setErrorMessage(null);
    try {
      const token = getStoredToken();
      if (kind === "brand") { await updateBrand(token, item.id, values.name.trim(), values.nameAr.trim(), values.nameZh?.trim()); loadBrands(); }
      else if (kind === "model") { await updateModel(token, item.id, values.name.trim(), values.nameAr?.trim(), values.nameZh?.trim()); openBrand(selectedBrand); }
      else if (kind === "generation") { await updateGeneration(token, item.id, values.name.trim(), parseInt(values.yearStart, 10), values.yearEnd ? parseInt(values.yearEnd, 10) : undefined); openModel(selectedModel); }
      setPendingEdit(null);
    } catch (err) {
      if (err instanceof SessionExpiredError) return onSessionExpired();
      setErrorMessage(err.message);
    } finally {
      setIsSavingEdit(false);
    }
  };

  // Replace an existing brand's photo (brands always have one).
  const handleReplaceBrandPhoto = async (id, file) => {
    if (!file) return;
    setReplacingBrandPhotoId(id);
    setErrorMessage(null);
    try {
      const token = getStoredToken();
      const uploadResult = await uploadCatalogImage(token, file);
      await updateBrandPhoto(token, id, uploadResult.url);
      loadBrands();
    } catch (err) {
      if (err instanceof SessionExpiredError) return onSessionExpired();
      setErrorMessage(err.message);
    } finally {
      setReplacingBrandPhotoId(null);
    }
  };

  // Add or replace the photo of an EXISTING year (how years created before the year photo existed get theirs).
  const handleReplaceYearPhoto = async (id, file) => {
    if (!file) return;
    setReplacingYearPhotoId(id);
    setErrorMessage(null);
    try {
      const token = getStoredToken();
      const uploadResult = await uploadCatalogImage(token, file);
      await updateGenerationPhoto(token, id, uploadResult.url);
      openModel(selectedModel);
    } catch (err) {
      if (err instanceof SessionExpiredError) return onSessionExpired();
      setErrorMessage(err.message);
    } finally {
      setReplacingYearPhotoId(null);
    }
  };

  const breadcrumb = (
    <div style={{ display: "flex", alignItems: "center", gap: 6, ...body, fontSize: 12.5, color: C.muted, marginBottom: 14 }}>
      <span onClick={backToBrands} style={{ cursor: selectedBrand ? "pointer" : "default", fontWeight: selectedBrand ? 400 : 700, color: selectedBrand ? C.muted : C.ink }}>Brands</span>
      {selectedBrand && <>
        <ChevronRight size={12} />
        <span onClick={backToModels} style={{ cursor: selectedModel ? "pointer" : "default", fontWeight: selectedModel ? 400 : 700, color: selectedModel ? C.muted : C.ink }}>{selectedBrand.name}</span>
      </>}
      {selectedModel && <>
        <ChevronRight size={12} />
        <span style={{ fontWeight: 700, color: C.ink }}>{selectedModel.name}</span>
      </>}
    </div>
  );

  const fieldStyle = { ...body, flex: 1, minWidth: 160, border: `1px solid ${C.line}`, borderRadius: 8, padding: "8px 11px", fontSize: 12.5, color: C.ink, background: C.card, outline: "none" };
  const photoPicker = (file, preview, onSelect) => (
    <>
      <label style={{ ...body, display: "flex", alignItems: "center", gap: 6, border: `1px solid ${file ? C.line : C.red}`, borderRadius: 8, padding: "8px 11px", fontSize: 12.5, fontWeight: 600, cursor: "pointer", color: C.ink, background: C.card }}>
        <ImagePlus size={14} />
        {file ? "Photo selected" : "Choose photo (required, at least 400 px)"}
        <input type="file" accept="image/jpeg,image/png,image/webp" onChange={onSelect} style={{ display: "none" }} />
      </label>
      {preview && <img src={preview} alt="" style={{ width: 32, height: 32, borderRadius: 6, objectFit: "cover" }} />}
    </>
  );
  const addButton = (onClick, uploading) => (
    <button disabled={isSubmitting} onClick={onClick} style={{ ...body, display: "flex", alignItems: "center", gap: 5, padding: "8px 14px", borderRadius: 8, border: "none", background: isSubmitting ? "#D1D5DB" : C.signal, color: C.onSignal, fontSize: 12.5, fontWeight: 700, cursor: isSubmitting ? "default" : "pointer" }}>
      <Check size={13} /> {uploading ? "Uploading…" : "Add"}
    </button>
  );
  const arrows = (kind, id, isFirst, isLast) => (
    <div style={{ display: "flex", flexDirection: "column", gap: 1 }}>
      <button onClick={() => handleMove(kind, id, "up")} disabled={isFirst} style={{ background: "none", border: "none", padding: 0, cursor: isFirst ? "default" : "pointer", opacity: isFirst ? 0.25 : 1 }} title="Move up"><ChevronUp size={13} color={C.ink} /></button>
      <button onClick={() => handleMove(kind, id, "down")} disabled={isLast} style={{ background: "none", border: "none", padding: 0, cursor: isLast ? "default" : "pointer", opacity: isLast ? 0.25 : 1 }} title="Move down"><ChevronDown size={13} color={C.ink} /></button>
    </div>
  );
  const rowStyle = { display: "flex", justifyContent: "space-between", alignItems: "center", padding: "10px 12px", borderBottom: `1px solid ${C.line}` };
  const mediaSrc = (url) => (url.startsWith("http") ? url : `${API_BASE_URL}${url}`);

  // Years are listed newest first.
  const sortedYears = [...years].sort((a, b) => b.yearStart - a.yearStart);

  // patch-vehicle-data-redesign: which step is open (0 Brand, 1 Model, 2 Year, 3 Version), the step bar, the search, the "..." menus, the card parts.
  const vdLevel = selectedYearEntry ? 3 : selectedModel ? 2 : selectedBrand ? 1 : 0;
  const yearText = (g) => (g ? (isSingleYearEntry(g) ? String(g.yearStart) : g.name) : "");
  const vdSteps = [
    { key: "brand", label: "Brand", value: selectedBrand ? selectedBrand.name : "Choose a brand", go: backToBrands },
    { key: "model", label: "Model", value: selectedModel ? selectedModel.name : selectedBrand ? "Choose a model" : "—", go: backToModels },
    { key: "year", label: "Year", value: selectedYearEntry ? yearText(selectedYearEntry) : selectedModel ? "Choose a year" : "—", go: backToYears },
    { key: "version", label: "Version", value: selectedYearEntry ? "Its versions" : "—", go: undefined },
  ];
  const vdQ = vdQuery.trim().toLowerCase();
  const vdMatch = (x) => !vdQ || [x.name, x.nameAr, x.nameZh].some((n) => n && String(n).toLowerCase().includes(vdQ));
  const vdShownBrands = brands.filter(vdMatch);
  const vdShownModels = models.filter(vdMatch);
  const vdListEmpty = vdLevel === 0 ? brands.length === 0 : vdLevel === 1 ? modelsLoaded && models.length === 0 : vdLevel === 2 ? yearsLoaded && sortedYears.length === 0 : false;
  const vdCard = { position: "relative", background: "#fff", border: `1px solid ${C.line}`, borderRadius: 14, boxShadow: "0 1px 2px rgba(11,49,70,0.05)", display: "flex", flexDirection: "column", justifyContent: "space-between" };
  const vdEmpty = { ...body, gridColumn: "1 / -1", fontSize: 13, color: C.muted, textAlign: "center", padding: 28, border: `1px dashed ${C.lineStrong}`, borderRadius: 12 };
  const vdMenuItem = { ...body, display: "flex", alignItems: "center", gap: 9, width: "100%", boxSizing: "border-box", padding: "8px 10px", borderRadius: 7, border: "none", background: "none", fontSize: 13, fontWeight: 700, color: C.ink, cursor: "pointer", textAlign: "left" };
  const vdLangInput = (tag, label, value, set, placeholder, rtl = false, width = null) => (
    <label style={{ display: "block", flex: width ? `0 0 ${width}px` : "1 1 180px", minWidth: 0 }}>
      <span style={{ ...body, display: "flex", alignItems: "center", gap: 6, fontSize: 11.5, fontWeight: 700, color: C.muted, marginBottom: 4 }}>
        <span style={{ ...mono, fontSize: 9.5, fontWeight: 800, color: "#fff", background: C.navy, borderRadius: 4, padding: "1px 5px" }}>{tag}</span>{label}
      </span>
      <input aria-label={label} value={value} onChange={(e) => set(e.target.value)} placeholder={placeholder} dir={rtl ? "rtl" : "ltr"} inputMode={tag === "YEAR" ? "numeric" : undefined}
        style={{ ...body, width: "100%", boxSizing: "border-box", height: 40, border: `1px solid ${C.line}`, borderRadius: 10, padding: "0 12px", fontSize: 13, color: C.ink, background: "#fff", outline: "none" }} />
    </label>
  );
  const vdMenu = (key, items, onPhoto = false) => (
    <>
      <button type="button" data-vd-menu="" onClick={(e) => { e.stopPropagation(); setVdMenuKey(vdMenuKey === key ? null : key); }} aria-label="Options" aria-haspopup="menu" aria-expanded={vdMenuKey === key}
        style={{ position: "absolute", right: 10, top: 10, width: 30, height: 30, borderRadius: 9, border: `1px solid ${C.line}`, background: vdMenuKey === key ? C.navy : onPhoto ? "rgba(255,255,255,0.95)" : "#fff", color: vdMenuKey === key ? "#fff" : C.ink, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", padding: 0, zIndex: 2 }}>
        <MoreHorizontal size={16} />
      </button>
      {vdMenuKey === key && (
        <div role="menu" data-vd-menu="" style={{ position: "absolute", right: 10, top: 46, zIndex: 30, minWidth: 190, background: "#fff", border: `1px solid ${C.line}`, borderRadius: 10, boxShadow: "0 10px 28px rgba(7,32,47,0.18)", padding: 5 }}>
          {items.map((it, n) => (
            <React.Fragment key={it.label}>
              {it.danger && n > 0 && <div style={{ height: 1, background: C.line, margin: "4px 2px" }} />}
              {it.onFile ? (
                <label role="menuitem" style={vdMenuItem}>
                  {it.icon} {it.label}
                  <input type="file" accept="image/jpeg,image/png,image/webp" onChange={(e) => { setVdMenuKey(null); it.onFile(e.target.files?.[0]); }} style={{ display: "none" }} />
                </label>
              ) : (
                <button type="button" role="menuitem" onClick={() => { setVdMenuKey(null); it.onClick(); }} style={{ ...vdMenuItem, color: it.danger ? C.red : C.ink }}>{it.icon} {it.label}</button>
              )}
            </React.Fragment>
          ))}
        </div>
      )}
    </>
  );
  const vdFooter = (countText, warnText, move) => (
    <div style={{ display: "flex", alignItems: "center", gap: 8, padding: "9px 12px", borderTop: `1px solid ${C.line}`, background: C.surfaceHigh, borderRadius: "0 0 14px 14px" }}>
      <span style={{ ...body, fontSize: 12, fontWeight: 700, color: C.muted }}>{countText}</span>
      {warnText && <span style={{ ...body, fontSize: 10.5, fontWeight: 800, color: C.amberInk, background: C.amberBg, borderRadius: 999, padding: "2px 8px" }}>{warnText}</span>}
      {move && (
        <span style={{ marginLeft: "auto", display: "inline-flex", gap: 4 }}>
          {[["up", ChevronLeft, "Move earlier", move[2]], ["down", ChevronRight, "Move later", move[3]]].map(([dir, Icon, title, off]) => (
            <button key={dir} type="button" onClick={() => handleMove(move[0], move[1], dir)} disabled={off} title={title} aria-label={title}
              style={{ width: 26, height: 26, borderRadius: 7, border: `1px solid ${C.line}`, background: "#fff", cursor: off ? "default" : "pointer", opacity: off ? 0.3 : 1, display: "flex", alignItems: "center", justifyContent: "center", padding: 0 }}>
              <Icon size={14} color={C.ink} />
            </button>
          ))}
        </span>
      )}
    </div>
  );

  if (loadState === "loading") {
    return <div><TopBar title="Vehicle Data" subtitle="Loading…" /><div style={{ padding: 24 }}><Card><div style={{ padding: 32, textAlign: "center", ...body, fontSize: 13, color: C.muted }}>Loading…</div></Card></div></div>;
  }
  if (loadState === "error" && !selectedBrand) {
    return <div><TopBar title="Vehicle Data" subtitle="" /><div style={{ padding: 24 }}><Card><div style={{ padding: 32, textAlign: "center", ...body, fontSize: 13, color: C.red }}>{errorMessage}</div></Card></div></div>;
  }

  return (
    <div>
      <TopBar title="Vehicle Data" subtitle="Add a vehicle step by step: Brand, Model, Year, then its Versions, by hand or by importing an Excel sheet. Names in English, Arabic and Chinese. Also the VIN decoder's own data tables" tabs={{ label: "Vehicle Data sections", tabs: VEHICLE_TABS.map(([id, label]) => ({ id, label })), activeId: activeTab, onSelect: setActiveTab }} />
      <div style={{ height: 24 }} />
      {activeTab === "brands" && (
        <div style={{ padding: "0 24px 24px" }}>
          {/* patch-vehicle-data-redesign: a step bar (Brand > Model > Year > Version), then the chosen step's page: a grid of cards, each with a "..." menu,
              a search on Brands and Models, and an "Add" form that opens from a button (and is open by itself when the list is empty). */}
          <div data-testid="vehicle-browser">
            <div style={{ display: "grid", gridTemplateColumns: "repeat(4, minmax(0, 1fr))", background: "#fff", border: `1px solid ${C.line}`, borderRadius: 14, boxShadow: SHADOW.card, marginBottom: 16, overflow: "hidden" }}>
              {vdSteps.map((s, i) => {
                const state = i < vdLevel ? "done" : i === vdLevel ? "now" : "next";
                return (
                  <button key={s.key} type="button" onClick={state === "done" ? s.go : undefined} disabled={state !== "done"} aria-current={state === "now" ? "step" : undefined}
                    style={{ ...body, display: "flex", alignItems: "center", gap: 10, padding: "12px 14px", border: "none", borderLeft: i ? `1px solid ${C.line}` : "none", background: state === "now" ? C.goldTint : "#fff", boxShadow: state === "now" ? `inset 0 -3px 0 ${C.signal}` : "none", cursor: state === "done" ? "pointer" : "default", textAlign: "left", minWidth: 0 }}>
                    <span style={{ width: 28, height: 28, borderRadius: "50%", flexShrink: 0, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 12.5, fontWeight: 800,
                      background: state === "done" ? C.navy : state === "now" ? C.signal : C.canvas, color: state === "done" ? "#fff" : state === "now" ? C.onSignal : C.muted, border: state === "next" ? `1px solid ${C.lineStrong}` : "none" }}>
                      {state === "done" ? <Check size={14} /> : i + 1}
                    </span>
                    <span style={{ minWidth: 0 }}>
                      <span style={{ display: "block", fontSize: 10.5, fontWeight: 800, letterSpacing: "0.08em", textTransform: "uppercase", color: C.muted }}>{s.label}</span>
