/**
 * The ORDER RECEIPT PDF (A4), the "navy band + info cards" design (patch-receipt-redesign, mix of canvas designs 1 and 3, confirmed with
 * the person): a navy band with the logo, the brand and the order number over a gold line; three soft cards (order, customer, delivery
 * address); the items in a rounded table with a navy header row and light zebra rows; the totals in a rounded box ending in a gold Total row.
 * A longer order continues on more pages: a slimmer navy band ("Order … · continued"), the table header again, "Continued on page N" under
 * the table, and the totals only on the last page.
 *
 *  - In the BUYER'S LANGUAGE: English, or Arabic laid out right to left.
 *  - In the BUYER'S CURRENCY: the currency and rate saved with the order when it was placed (migration 123); for an older order, the currency
 *    the buyer has chosen now, at today's rate; else US dollars.
 *  - A long item name wraps and its row grows; every page ends with the admin's footer note and "Page x of y".
 *  - Arabic text (a name or an address typed in Arabic) is printed with an Arabic font, joined and right to left, on the English receipt too.
 *    (`bidi` is the bidi-js instance, `reshaper` arabic-reshaper: see forPdf below for why both.)
 */
const fs = require('fs');
const { arabicWidth, drawArabic } = require('../shared/arabicPdf');      // Arabic joined and right to left, on any PDFKit version

const ARABIC = /[؀-ۿݐ-ݿﭐ-﷿ﹰ-﻿]/;
const AR_SYMBOL = { SAR: 'ر.س', AED: 'د.إ', KWD: 'د.ك', QAR: 'ر.ق', BHD: 'د.ب', OMR: 'ر.ع', EGP: 'ج.م', JOD: 'د.أ', USD: '$' };
const THREE_DECIMALS = new Set(['KWD', 'BHD', 'OMR', 'JOD']);

const TEXT = {
  en: { brand: 'Leap Auto Parts', title: 'Order receipt', order: 'Order', placed: 'Placed', customer: 'CUSTOMER', address: 'DELIVERY ADDRESS', guest: 'Guest',
    item: 'Item', qty: 'Qty', unit: 'Unit price', total: 'Total', subtotal: 'Subtotal', discount: 'Discount', shipping: 'Shipping fees', grand: 'Total',
    page: (a, b) => `Page ${a} of ${b}`, continued: 'continued',
    orderLabel: 'ORDER', items: (n) => `${n} ${n === 1 ? 'item' : 'items'}`, nextPage: (n) => `Continued on page ${n} - the totals are at the end.` },
  ar: { brand: 'ليب لقطع السيارات', title: 'إيصال الطلب', order: 'الطلب', placed: 'تاريخ الطلب', customer: 'العميل', address: 'عنوان التوصيل', guest: 'ضيف',
    item: 'الصنف', qty: 'الكمية', unit: 'سعر الوحدة', total: 'الإجمالي', subtotal: 'المجموع الفرعي', discount: 'الخصم', shipping: 'رسوم الشحن', grand: 'الإجمالي الكلي',
    page: (a, b) => `صفحة ${a} من ${b}`, continued: 'تابع',
    orderLabel: 'الطلب', items: (n) => (n === 1 ? 'صنف واحد' : n === 2 ? 'صنفان' : n <= 10 ? `${n} أصناف` : `${n} صنفاً`), nextPage: (n) => `يتبع في الصفحة ${n}، المجاميع في النهاية` },
};

/** The currency a receipt is shown in: { code, rate } (rate = units of `code` per 1 US dollar). */
async function receiptCurrency(db, order, requested) {
  if (order.display_currency && Number(order.display_rate) > 0) return { code: order.display_currency, rate: Number(order.display_rate) };
  const code = typeof requested === 'string' ? requested.trim().toUpperCase() : '';
  if (/^[A-Z]{3}$/.test(code) && code !== 'USD') {
    const { rows } = await db.query('SELECT rate FROM fx_rates WHERE currency_pair = $1', [`USD_${code}`]);
    if (rows.length > 0 && Number(rows[0].rate) > 0) return { code, rate: Number(rows[0].rate) };
  }
  return { code: 'USD', rate: 1 };
}

function moneyFormatter(currency, isAr) {
  const digits = THREE_DECIMALS.has(currency.code) ? 3 : 2;
  return (usd) => {
    const n = (Number(usd) || 0) * currency.rate;
    const s = n.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });
    if (isAr) return `${s} ${AR_SYMBOL[currency.code] || currency.code}`;
    return currency.code === 'USD' ? `$${s}` : `${currency.code} ${s}`;
  };
}

/**
 * Draws the receipt into a PDFKit document (created with { size: 'A4', bufferPages: true }) and ends it.
 * data: { lang, orderId, placedAt, title?, customerName, address: [lines] | null, items: [{ name, quantity, unitUsd }], discountUsd, shippingUsd,
 *         totalUsd, currency: { code, rate }, footerNote, logoPath, fonts: { arabicRegular, arabicBold } }
 * address lines, as the order route gives them: [recipient name, phone, street, city + postal code, country].
 */
function drawReceipt(doc, data, bidi, reshaper) {
  const isAr = data.lang === 'ar';
  const T = TEXT[isAr ? 'ar' : 'en'];
  const money = moneyFormatter(data.currency, isAr);
  // the LEAP portal colours (design system "LEAP Portals")
  const C = { ink: '#14171C', grey: '#636B78', light: '#7A818C', line: '#E4E6EA', high: '#F9FAFB', zebra: '#F5F6F8', navy: '#0B3146',
    onNavy: '#FFFFFF', onNavyMuted: '#9FB4C3', gold: '#F9B317' };

  // patch-receipt-arial-logo: Arial for Arabic. It is used only when its file is there AND it has the joined Arabic letter shapes
  // (drawArabic needs them); otherwise the fallback font (Noto Sans Arabic) is used, so a missing or old Arial never breaks a receipt.
  const usable = (src, tag) => {
    if (!src || (typeof src === 'string' && !fs.existsSync(src))) return false;
    try {
      doc.registerFont(tag, src);
      doc.font(tag);
      const f = doc._font && doc._font.font;
      return !f || typeof f.hasGlyphForCodePoint !== 'function' || [0x0627, 0xFE8E, 0xFEDF, 0xFEE0, 0xFEFB].every((c) => f.hasGlyphForCodePoint(c));
    } catch { return false; }
  };
  const pickFont = (main, fallback, tag) => (usable(main, `${tag}-try`) ? main : fallback || main);
  doc.registerFont('Ar', pickFont(data.fonts.arabicRegular, data.fonts.fallbackRegular, 'ArR'));
  doc.registerFont('Ar-Bold', pickFont(data.fonts.arabicBold, data.fonts.fallbackBold, 'ArB'));

  const W = doc.page.width;
  const H = doc.page.height;
  const side = 36;
  const left = side;
  const right = W - side;
  const width = right - left;
  const footerY = H - 52;                               // the thin line above the footer
  const contentBottom = footerY - 12;
  const start = isAr ? 'right' : 'left';
  const end = isAr ? 'left' : 'right';
  const X = (offset, w) => (isAr ? right - offset - w : left + offset);   // a box `offset` in from the START side, `w` wide
  const upper = (s) => (isAr ? s : String(s).toUpperCase());

  // Arabic is joined and laid out right to left by drawArabic (shared/arabicPdf), the same on every PDFKit version; `bidi` and `reshaper`
  // stay in the signature for the callers.
  function arabicLines(raw, w) {
    const words = raw.split(/\s+/).filter(Boolean);
    const lines = [];
    let cur = '';
    for (const word of words) {
      const next = cur ? `${cur} ${word}` : word;
      if (cur && arabicWidth(doc, next) > w) { lines.push(cur); cur = word; } else cur = next;
    }
    if (cur) lines.push(cur);
    return lines.length ? lines : [''];
  }

  // Writes one piece of text in the receipt's font, or an Arabic font when it contains Arabic. Returns the height it took.
  function put(text, x, y, { w, align = start, size = 10, bold = false, color = C.ink, measureOnly = false } = {}) {
    const raw = text === null || text === undefined ? '' : String(text);
    if (ARABIC.test(raw)) {
      doc.font(bold ? 'Ar-Bold' : 'Ar').fontSize(size);
      const lh = doc.currentLineHeight(true);
      const lines = arabicLines(raw, w);
      if (!measureOnly) lines.forEach((line, i) => { doc.fillColor(color); drawArabic(doc, line, x, y + i * lh, { width: w, align }); });
      return lines.length * lh;
    }
    // text with no Arabic in it (order number, date, phone, quantity) in Helvetica on both receipts: the Arabic font would lay
    // "+962 79 123 4567" out right to left, word by word
    doc.font(bold ? 'Helvetica-Bold' : 'Helvetica').fontSize(size);
    const h = doc.heightOfString(raw || ' ', { width: w });
    if (!measureOnly) doc.fillColor(color).text(raw, x, y, { width: w, align, lineBreak: true });
    return h;
  }
  const label = (text, x, y, w, color = C.grey) => put(upper(text), x, y, { w, size: 7.5, bold: true, color });

  function logo(x, y, size) {
    // the round gold LEAP logo, straight on the navy band (patch-receipt-arial-logo)
    if (data.logoPath && (typeof data.logoPath !== 'string' || data.logoPath.startsWith('data:') || fs.existsSync(data.logoPath))) {
      doc.image(data.logoPath, x, y, { width: size, height: size });
    }
  }

  // ---- the navy band: page 1 tall, the next pages slim
  function bigBand() {
    const bandH = 86;
    doc.rect(0, 0, W, bandH).fill(C.navy);
    doc.rect(0, bandH, W, 4.5).fill(C.gold);
    const size = 48;
    const ly = 19;
    logo(X(0, size), ly, size);
    const textW = width / 2 - size - 10;
    put(T.brand, X(size + 12, textW), ly + 7, { w: textW, size: 16, bold: true, color: C.onNavy });
    put(data.title || T.title, X(size + 12, textW), ly + 28, { w: textW, size: 9.5, color: C.onNavyMuted });
    const ow = width / 2;
    put(upper(T.orderLabel), X(width - ow, ow), ly + 7, { w: ow, size: 7.5, bold: true, color: C.gold, align: end });
    put(data.orderId, X(width - ow, ow), ly + 18, { w: ow, size: 16, bold: true, color: C.onNavy, align: end });
    return bandH + 4.5;
  }
  function slimBand() {
    const bandH = 42;
    doc.rect(0, 0, W, bandH).fill(C.navy);
    doc.rect(0, bandH, W, 3).fill(C.gold);
    const size = 30;
    logo(X(0, size), 6, size);
    put(T.brand, X(size + 9, width / 2), 14, { w: width / 2, size: 11, bold: true, color: C.onNavy });
    put(`${T.order} ${data.orderId} · ${T.continued}`, X(width / 2, width / 2), 15, { w: width / 2, size: 9.5, color: C.onNavyMuted, align: end });
    return bandH + 3;
  }

  // ---- the three cards: order, customer, delivery address
  function cards(y) {
    const gap = 9;
    const cw = (width - gap * 2) / 3;
    const pad = 12;
    const iw = cw - pad * 2;
    const a = (data.address || []).map((l) => (l === null || l === undefined ? '' : String(l).trim()));
    const phone = a[1] || '';
    const addrLines = a.slice(2).filter(Boolean);
    const blocks = [
      [T.order, [[data.orderId, 10.5, true, C.ink], [`${T.placed} ${data.placedAt}`, 8.5, false, C.grey], [T.items(data.items.length), 8.5, false, C.grey]]],
      [T.customer, [[data.customerName || T.guest, 10.5, true, C.ink], ...(phone ? [[phone, 8.5, false, C.grey]] : [])]],
      [T.address, addrLines.length ? addrLines.map((l) => [l, 9, false, C.ink]) : [['-', 9, false, C.grey]]],
    ];
    const heights = blocks.map(([, lines]) => 12 + lines.reduce((s, [t, size, bold]) => s + put(t, 0, 0, { w: iw, size, bold, measureOnly: true }) + 1, 0));
    const ch = Math.max(...heights) + pad * 2;
    blocks.forEach(([title, lines], i) => {
      const x = X(i * (cw + gap), cw);
      doc.lineWidth(0.75).roundedRect(x, y, cw, ch, 10).fillAndStroke(C.high, C.line);
      let cy = y + pad;
      label(title, x + pad, cy, iw);
      cy += 12;
      for (const [t, size, bold, color] of lines) cy += put(t, x + pad, cy, { w: iw, size, bold, color }) + 1;
    });
    return y + ch;
  }

  // ---- the items table
  const qtyW = 40, unitW = 82, totW = 84, gap = 8, pad = 10;
  const itemW = width - qtyW - unitW - totW - gap * 3 - pad * 2;
  const col = (offset, w) => X(pad + offset, w);
  const cols = { item: col(0, itemW), qty: col(itemW + gap, qtyW), unit: col(itemW + qtyW + gap * 2, unitW), tot: col(itemW + qtyW + unitW + gap * 3, totW) };
  const headH = 24;
  const rowOf = (item) => Math.max(put(item.name, 0, 0, { w: itemW, size: 9, measureOnly: true }), 11) + 14;
  const rows = data.items.map((item) => ({ item, h: rowOf(item) }));

  function drawTable(y, list, firstIndex) {
    const h = headH + list.reduce((s, r) => s + r.h, 0);
    doc.save();
    doc.roundedRect(left, y, width, h, 10).clip();
    doc.rect(left, y, width, headH).fill(C.navy);
    let ry = y + headH;
    list.forEach((r, i) => {
      if ((firstIndex + i) % 2 === 1) doc.rect(left, ry, width, r.h).fill(C.zebra);
      if (i > 0) doc.moveTo(left, ry).lineTo(right, ry).lineWidth(0.75).strokeColor(C.line).stroke();
      ry += r.h;
    });
    doc.restore();
    doc.roundedRect(left, y, width, h, 10).lineWidth(0.75).strokeColor(C.line).stroke();
    const hy = y + 8;
    put(upper(T.item), cols.item, hy, { w: itemW, size: 7.5, bold: true, color: C.onNavy });
    put(upper(T.qty), cols.qty, hy, { w: qtyW, size: 7.5, bold: true, color: C.onNavy, align: 'center' });
    put(upper(T.unit), cols.unit, hy, { w: unitW, size: 7.5, bold: true, color: C.onNavy, align: end });
    put(upper(T.total), cols.tot, hy, { w: totW, size: 7.5, bold: true, color: C.onNavy, align: end });
    ry = y + headH;
    for (const { item, h: rh } of list) {
      const ty = ry + 7;
      put(item.name, cols.item, ty, { w: itemW, size: 9, bold: false });
      put(String(item.quantity), cols.qty, ty, { w: qtyW, size: 9, align: 'center' });
      put(money(item.unitUsd), cols.unit, ty, { w: unitW, size: 9, align: end });
      put(money(item.unitUsd * item.quantity), cols.tot, ty, { w: totW, size: 9, bold: true, align: end });
      ry += rh;
    }
    return y + h;
  }

  // ---- the totals box
  const sumLines = [[T.subtotal, money(data.items.reduce((s, i) => s + i.unitUsd * i.quantity, 0))]];
  if (Number(data.discountUsd) > 0) sumLines.push([T.discount, `- ${money(data.discountUsd)}`]);
  if (Number(data.shippingUsd) > 0) sumLines.push([T.shipping, `+ ${money(data.shippingUsd)}`]);
  const boxW = 232;
  const grandH = 32;
  const totalsH = 14 + 10 + sumLines.length * 15 + 6 + grandH;
  function drawTotals(y) {
    y += 14;
    const bx = X(width - boxW, boxW);
    const bh = 10 + sumLines.length * 15 + 6 + grandH;
    doc.save();
    doc.roundedRect(bx, y, boxW, bh, 10).clip();
    doc.rect(bx, y, boxW, bh).fill('#FFFFFF');
    doc.rect(bx, y + bh - grandH, boxW, grandH).fill(C.gold);
    doc.restore();
    doc.roundedRect(bx, y, boxW, bh, 10).lineWidth(0.75).strokeColor(C.line).stroke();
    const half = boxW / 2 - 14;
    const lx = isAr ? bx + boxW - 14 - half : bx + 14;       // label on the start side
    const vx = isAr ? bx + 14 : bx + boxW - 14 - half;       // value on the end side
    let ly = y + 10;
    for (const [l, v] of sumLines) {
      put(l, lx, ly, { w: half, size: 9, color: C.grey, align: start });
      put(v, vx, ly, { w: half, size: 9, color: C.ink, align: end });
      ly += 15;
    }
    const gy = y + bh - grandH + 9;
    put(T.grand, lx, gy, { w: half, size: 11.5, bold: true, color: C.navy, align: start });
    put(money(data.totalUsd), vx, gy - 0.5, { w: half, size: 12.5, bold: true, color: C.navy, align: end });
    return y + bh;
  }

  // ---- lay the rows out on pages: page 1 under the cards, the next pages under the slim band; the totals go after the last row,
  //      and when they would not fit, the last rows move with them to the next page
  const contLineH = 18;
  let y = cards(bigBand() + 15) + 15;
  const pages = [];
  let cur = { top: y, rows: [] };
  let used = headH;
  for (const r of rows) {
    if (cur.rows.length > 0 && cur.top + used + r.h + contLineH > contentBottom) {
      pages.push(cur);
      cur = { top: null, rows: [] };
      used = headH;
    }
    cur.rows.push(r);
    used += r.h;
  }
  pages.push(cur);
  const fitsTotals = (p, hUsed) => (p.top === null ? 45 + 15 : p.top) + hUsed + totalsH <= contentBottom;
  const last = pages[pages.length - 1];
  const usedOf = (p) => (p.rows.length ? headH + p.rows.reduce((s, r) => s + r.h, 0) : 0);
  if (!fitsTotals(last, usedOf(last))) {
    // the totals do not fit under the last rows: carry the last row or two over with them, so the totals never sit alone on a page
    const moved = [];
    while (last.rows.length > 1 && moved.length < 2) moved.unshift(last.rows.pop());
    pages.push({ top: null, rows: moved });
  }

  let index = 0;
  pages.forEach((p, i) => {
    if (i > 0) {
      doc.addPage({ size: 'A4', margins: { top: 0, bottom: 0, left: side, right: side } });
      p.top = slimBand() + 15;
    }
    let py = p.top;
    if (p.rows.length) py = drawTable(py, p.rows, index);
    index += p.rows.length;
    if (i < pages.length - 1) put(T.nextPage(i + 2), left, py + 6, { w: width, size: 8.5, bold: true, color: C.navy, align: end });
    else drawTotals(py);
  });

  // ---- footer on every page: the admin's note and "Page x of y" under a thin line
  const range = doc.bufferedPageRange();
  for (let i = range.start; i < range.start + range.count; i += 1) {
    doc.switchToPage(i);
    const saved = doc.page.margins.bottom;
    doc.page.margins.bottom = 0;                          // writing in the bottom margin must not start a new page
    doc.moveTo(left, footerY).lineTo(right, footerY).lineWidth(0.75).strokeColor(C.line).stroke();
    const fy = footerY + 9;
    put(T.page(i - range.start + 1, range.count), X(width - 120, 120), fy, { w: 120, size: 8, bold: true, color: C.light, align: end });
    if (data.footerNote) put(data.footerNote, X(0, width - 140), fy, { w: width - 140, size: 8, color: C.light, align: start });
    doc.page.margins.bottom = saved;
  }
  doc.end();
}
module.exports = { drawReceipt, receiptCurrency, moneyFormatter, TEXT };
