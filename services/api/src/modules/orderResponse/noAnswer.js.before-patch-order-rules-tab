const db = require('../../../db/pool');
const { createNotification } = require('../notifications/helpers');
const { supplierUnitPriceCny } = require('../shared/supplierMoney');

/**
 * A supplier did not answer a new order within 24 hours (confirmed with the person via mockup, option C: automatic, with the admin's rules).
 * The rules (one row, set in admin > Orders > Refused / no answer):
 *   then_action             'move' (give it to another supplier with the same OEM number) | 'resend' (24 more hours for the same supplier) | 'ask' (tell the admin, as before)
 *   pick_by                 how the new supplier is chosen: 'price' (lowest supplier price) | 'stock' (most stock)
 *   max_price_increase_pct  the new supplier's price may be at most this much above the first one's; otherwise the admin is asked
 *   if_none                 when no other supplier can take it: 'resend' | 'ask'
 *   max_resends             how many times it may be sent again to the same supplier before the admin is asked
 * The buyer always keeps the price they paid. The new supplier gets 24 hours, with the usual reminders. Every step is written to sub_order_events.
 */
const DEFAULT_RULES = { thenAction: 'move', pickBy: 'price', maxPriceIncreasePct: 10, ifNone: 'resend', maxResends: 1 };
const ANSWER_HOURS = 24;

class NoAnswerError extends Error { constructor(message, status = 400) { super(message); this.status = status; } }

function rulesFromRow(r) {
  if (!r) return { ...DEFAULT_RULES };
  return { thenAction: r.then_action, pickBy: r.pick_by, maxPriceIncreasePct: Number(r.max_price_increase_pct), ifNone: r.if_none, maxResends: Number(r.max_resends), updatedAt: r.updated_at };
}
async function getRules(client = db) {
  const { rows } = await client.query('SELECT * FROM order_no_answer_rules WHERE id = 1');
  return rulesFromRow(rows[0]);
}
async function saveRules(input, adminId) {
  const r = { ...DEFAULT_RULES, ...(input || {}) };
  if (!['move', 'resend', 'ask'].includes(r.thenAction)) throw new NoAnswerError("thenAction must be 'move', 'resend' or 'ask'");
  if (!['price', 'stock'].includes(r.pickBy)) throw new NoAnswerError("pickBy must be 'price' or 'stock'");
  if (!['resend', 'ask'].includes(r.ifNone)) throw new NoAnswerError("ifNone must be 'resend' or 'ask'");
  const pct = Number(r.maxPriceIncreasePct); const resends = Number(r.maxResends);
  if (!Number.isFinite(pct) || pct < 0 || pct > 100) throw new NoAnswerError('maxPriceIncreasePct must be between 0 and 100');
  if (!Number.isInteger(resends) || resends < 0 || resends > 5) throw new NoAnswerError('maxResends must be a whole number from 0 to 5');
  const { rows } = await db.query(
    `INSERT INTO order_no_answer_rules (id, then_action, pick_by, max_price_increase_pct, if_none, max_resends, updated_at, updated_by)
     VALUES (1, $1, $2, $3, $4, $5, now(), $6)
     ON CONFLICT (id) DO UPDATE SET then_action = $1, pick_by = $2, max_price_increase_pct = $3, if_none = $4, max_resends = $5, updated_at = now(), updated_by = $6
     RETURNING *`,
    [r.thenAction, r.pickBy, pct, r.ifNone, resends, adminId || null]
  );
  return rulesFromRow(rows[0]);
}

async function recordEvent(client, { subOrderId, orderId, kind, detail = null, byAdmin = null }) {
  await client.query('INSERT INTO sub_order_events (sub_order_id, order_id, kind, detail, by_admin) VALUES ($1, $2, $3, $4, $5)', [subOrderId, orderId, kind, detail, byAdmin]);
}
async function historyFor(subOrderId) {
  const { rows: so } = await db.query('SELECT order_id FROM supplier_sub_orders WHERE id = $1', [subOrderId]);
  if (so.length === 0) throw new NoAnswerError('Sub-order not found', 404);
  const { rows } = await db.query('SELECT e.*, s.name AS supplier_name FROM sub_order_events e JOIN supplier_sub_orders so ON so.id = e.sub_order_id JOIN suppliers s ON s.id = so.supplier_id WHERE e.order_id = $1 ORDER BY e.created_at, e.id', [so[0].order_id]);
  return rows.map((r) => ({ at: r.created_at, kind: r.kind, detail: r.detail, byAdmin: r.by_admin, subOrderId: r.sub_order_id, supplierName: r.supplier_name }));
}

// ---- the words (English and Arabic, like the other order notifications)
