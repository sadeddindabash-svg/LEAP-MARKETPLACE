const express = require('express');
const db = require('../../../db/pool');
const { calculateBuyerPriceUsd, MissingShippingDataError } = require('../pricing/engine');
const { withEffectiveShipping } = require('../shared/partShipping');
const { readFreeShipping, computeShipping } = require('../shared/freeShipping');
const { findMatchingDiscountRule } = require('../pricing/discountRules');
const { buildSupplierLabelMap } = require('../shared/supplierAnonymize');
const { CAR_JOIN, CAR_COLUMNS, buyerName, withCar } = require('../shared/carName');      // buyer names: name + car brand + model
const { fitTitleFor } = require('../shared/fitTitle');      // the title in parts (patch-name-car-part)
const { validatePromoCode, calculateDiscountUsd } = require('../promotions/helpers');
const { getLoyaltyDiscountPercentage } = require('../loyalty/helpers');
const { optionalAuth } = require('../auth/middleware');
const discountHold = require('../discountHold/rules');      // Pricing > Discount rules > Rules: how a discount price is held (migration 143)

/**
 * Cart module — BUY-030–032. Cart holds items from multiple suppliers; the
 * split into supplier sub-orders happens at checkout (see order module).
 *
 * Backed by PostgreSQL. The cart row is created lazily on first item add if
 * it doesn't already exist (cartId is client-generated — a UUID from the
 * mobile app, for example — so there's no separate "create cart" call).
 *
 * All three endpoints below return the same full item shape (name, price,
 * currencyCode, supplierName) rather than POST/DELETE returning a
 * stripped-down productId/quantity pair — this way the client (e.g. the
 * mobile app's cart screen, which groups items by supplier) never needs an
 * extra round-trip after a mutation just to redisplay the cart.
 */
const router = express.Router();

async function ensureCartExists(cartId) {
  await db.query('INSERT INTO carts (id) VALUES ($1) ON CONFLICT (id) DO NOTHING', [cartId]);
}

// Confirmed with the person through several rounds of clarification:
// extracted from getFullCart's own original inline logic so the new
// /lock-prices endpoint below can compute this exact same real,
// live price too, when snapshotting it at the moment checkout
// genuinely begins.
async function computeLivePrice(r) {
  const discountPercentage = await findMatchingDiscountRule(r.product_id);
  if (r.currency_code !== 'CNY') {
    // Legacy pre-pricing-engine product — pass through unchanged (see
    // the same handling in the catalog module for why).
    const basePrice = Number(r.price);
    const price = discountPercentage !== null ? basePrice * (1 - discountPercentage / 100) : basePrice;
    const originalPrice = discountPercentage !== null ? basePrice : null;
    return { price, originalPrice, currencyCode: r.currency_code };
  }
  // The weight and size of the product, else its part's (migration 104).
  const shipped = await withEffectiveShipping(r);
  const result = await calculateBuyerPriceUsd({
    supplierCostCny: Number(r.price),
    weightKg: shipped.weight_kg === null ? null : Number(shipped.weight_kg),
    lengthCm: shipped.length_cm === null ? null : Number(shipped.length_cm),
    widthCm: shipped.width_cm === null ? null : Number(shipped.width_cm),
    heightCm: shipped.height_cm === null ? null : Number(shipped.height_cm),
  });
  const basePriceUsd = result.buyerPriceUsd;
  const price = discountPercentage !== null ? basePriceUsd * (1 - discountPercentage / 100) : basePriceUsd;
  const originalPrice = discountPercentage !== null ? basePriceUsd : null;
  return { price, originalPrice, currencyCode: 'USD' };
}

// The car of a quotation, for the basket: "GAC GS8 2024 320T Luxury" (Arabic names when asked and known).
function quotationCarLine(raw, lang) {
  let v = raw;
  if (typeof v === 'string') { try { v = JSON.parse(v); } catch { v = null; } }
  if (!v || typeof v !== 'object') return null;
  const ar = lang === 'ar';
  return [ar && v.makeAr ? v.makeAr : v.make, ar && v.modelAr ? v.modelAr : v.model, v.year, ar && v.versionAr ? v.versionAr : v.version].filter(Boolean).join(' ') || null;
}

// A part put in the basket from a quotation ("Order these parts", migration 141): kept only when the signed-in buyer's OWN quotation holds that part.
async function quotationFor(req, productId) {
  const id = req.body && typeof req.body.quotationId === 'string' ? req.body.quotationId : null;
  if (!id || !req.user || !req.user.sub) return null;
  const { rows } = await db.query(
    'SELECT 1 FROM quotations q JOIN quotation_items qi ON qi.quotation_id = q.id WHERE q.id = $1 AND q.buyer_id = $2 AND qi.product_id = $3', [id, req.user.sub, productId]);
  return rows.length > 0 ? id : null;
}

// The checkout hold's length is set in Pricing > Discount rules > Rules (15 to 180 minutes; 60 when the rules are not there yet).

// `lang` ('ar' | anything else) picks which approved product name to return --
// same rule as catalog's resolveLanguage(): Arabic name when requested AND one
// exists, otherwise the default name. Without this a basket always showed the
// English name even for products with an approved Arabic translation.
async function getFullCart(cartId, tokenBuyerId, lang) {
  const { rows: cartRows } = await db.query('SELECT buyer_id, applied_promo_code, checkout_locked_at FROM carts WHERE id = $1', [cartId]);
  let buyerId = cartRows[0]?.buyer_id || null;
  // Confirmed with the person through direct diagnosis of a real,
  // broken loyalty discount: a real cart is created anonymously
  // (correct -- guest checkout must work), but nothing previously
  // ever linked it to the buyer once they logged in, so every real
  // cart's buyer_id stayed null forever. Claims the cart for this
  // real buyer, once, the first time a real logged-in request for it
  // arrives -- a lasting link, not re-derived fresh (and forgotten)
  // on every request.
  if (!buyerId && tokenBuyerId) {
    await db.query('UPDATE carts SET buyer_id = $1 WHERE id = $2', [tokenBuyerId, cartId]);
    buyerId = tokenBuyerId;
  }
  let appliedPromoCode = cartRows[0]?.applied_promo_code || null;
  const checkoutLockedAt = cartRows[0]?.checkout_locked_at || null;
  // Confirmed with the person: explicitly re-derived on every real
  // read (not trusted from a stale client-side timer) -- a lock is
  // only genuinely still active if checkout_locked_at is set AND
  // within the real last 60 minutes.
  const holdRules = await discountHold.getRules();
  const lockActive = discountHold.isLockActive(checkoutLockedAt, holdRules);
  const lockExpiresAt = lockActive ? new Date(new Date(checkoutLockedAt).getTime() + discountHold.holdMs(holdRules)).toISOString() : null;

  const { rows } = await db.query(
    `SELECT ci.product_id, ci.quantity, ci.locked_price, ci.held_quantity, ci.extra_locked_price, ci.drop_told_at, ci.quotation_id, qt.party_name AS quotation_party, qt.vehicle AS quotation_vehicle, p.name, p.name_ar, p.price, p.currency_code, p.category, p.part, p.weight_kg, p.length_cm, p.width_cm, p.height_cm, p.stock_quantity, p.supplier_id, ${CAR_COLUMNS}
     FROM cart_items ci
     JOIN products p ON p.id = ci.product_id
     ${CAR_JOIN}
     -- a part put in the basket from one of the buyer's quotations (migration 141): the basket groups it under that quotation
     LEFT JOIN quotations qt ON qt.id = ci.quotation_id
     WHERE ci.cart_id = $1
     -- the order the products were put in the basket (migration 140): a changed quantity never moves a card
     ORDER BY ci.added_at ASC, ci.product_id ASC`,
    [cartId]
  );
  // Real supplier anonymization (new, business decision confirmed
  // directly): a buyer should never see a real supplier's name
  // anywhere in the app. Built once here, across every real item in
  // this cart, so the SAME real supplier gets the SAME anonymized
  // label consistently across every item in this one real response
  // (see shared/supplierAnonymize.js's own header comment for the
  // full real numbering scheme).
  const supplierLabelMap = buildSupplierLabelMap(rows.map((r) => r.supplier_id), cartId);
  // Same real, live pricing calculation as the catalog module (see
  // services/api/src/modules/pricing/engine.js) — the cart shows the
  // real current buyer price, not the supplier's RMB cost, and reflects
  // a fee/rate change immediately, same as browsing. This is
  // deliberately NOT locked in yet; that happens at order placement
  // (see the order module) — see migration 014's header comment for why.
  //
  // Confirmed with the person through several rounds of clarification
  // (migration 076): EXCEPT during an active real checkout price lock
  // -- while lockActive, the real, live-computed price is still
  // computed here (needed to detect and flag a genuine change), but
  // the real, DISPLAYED/CHARGED price is the real locked_price
  // snapshot instead, frozen at whatever it was the moment checkout
  // genuinely began.
  const items = (await Promise.all(rows.map(async (r) => {
    let live;
    try {
      live = await computeLivePrice(r);
    } catch (err) {      // no weight and size: the line is left out of the cart shown (still saved), instead of the whole cart failing
      if (err instanceof MissingShippingDataError) { console.error(`[cart] product ${r.product_id} is left out of the cart: ${err.message}`); return null; }
      throw err;
    }
    // The weight shown for the line: the product's, else its part's (migration 104); the same one the price was worked out from.
    const shippedRow = await withEffectiveShipping(r);
    const effectiveWeightKg = shippedRow.weight_kg === null ? null : Number(shippedRow.weight_kg);
    let price = live.price;
    let originalPrice = live.originalPrice;
    let priceChanged = false;
    // The price lines of this part (Pricing > Discount rules > Rules): during a hold, the held units and the units added during the
    // hold can be two lines at two prices; a lower live price lowers them. `price` is their average, so price x quantity is the line total.
    const held = discountHold.priceLines(r, live, lockActive, holdRules);
    if (lockActive && r.locked_price !== null) {
      priceChanged = held.lines.some((l) => Math.abs(l.price - live.price) > 0.001);
      price = held.price;
      // the price before any discount for the whole part (its struck-through price and the "You save" of the summary): the lines' own prices before the discount
      const beforeTotal = held.lines.reduce((s, l) => s + (l.originalPrice && l.originalPrice > l.price ? l.originalPrice : l.price) * l.quantity, 0);
      originalPrice = beforeTotal > held.total + 0.004 ? beforeTotal / Number(r.quantity) : null;
      const lowered = held.lines.find((l) => l.lowered);
      if (lowered && (!r.drop_told_at || new Date(r.drop_told_at) < new Date(checkoutLockedAt))) {
        // step 4: told once per hold
        const { rowCount } = await db.query('UPDATE cart_items SET drop_told_at = now() WHERE cart_id = $1 AND product_id = $2 AND (drop_told_at IS NULL OR drop_told_at < $3) RETURNING cart_id', [cartId, r.product_id, checkoutLockedAt]);
        if (rowCount) {
          await discountHold.recordEvent({ cartId, productId: r.product_id, kind: 'lowered', detail: `price dropped to ${discountHold.usd(lowered.price)} during the hold` });
          if (holdRules.tellDrop) await discountHold.tellBuyer(buyerId, discountHold.words.priceDropped(buyerName(r, 'en'), lowered.price), { type: 'product', id: r.product_id });
        }
      }
      // Confirmed simplest, most consistent interpretation: the real
      // locked amount is the single, final number that matters --
      // originalPrice (the struck-through discount display) stays
      // live even during a real lock, since it's purely informational
      // and never what's actually charged.
    }
    // Real primary product image (new) -- closes a real gap: no image
    // at all was returned for a cart item before, so neither the cart
    // screen nor checkout's own itemized summary could show one, only
    // the product's name as plain text. Images live in their own
    // real, one-to-many product_images table (see catalog/routes.js's
    // own identical pattern) -- the first one by real sort_order is
    // the real primary image, same definition used everywhere else in
    // this codebase.
    const { rows: imageRows } = await db.query('SELECT url FROM product_images WHERE product_id = $1 ORDER BY sort_order LIMIT 1', [r.product_id]);
    return {
      productId: r.product_id,
      quantity: r.quantity,
      name: buyerName(r, lang),
      fitTitle: await fitTitleFor(db, r.product_id, lang),
      price,
      originalPrice,
      priceChanged,
      // one line, or two during a hold (held units + units added later): [{ quantity, price, held, lowered, isNew, originalPrice }]
      lines: held.lines,
      lineTotal: held.total,
      currencyCode: live.currencyCode,
      imageUrl: imageRows[0]?.url || null,
      // Real stock quantity (new) -- lets the client warn/clamp a
      // buyer BEFORE they hit checkout, rather than the only real
      // guard being order placement's atomic stock_quantity >= $1
      // decrement (services/api/src/modules/order/routes.js) -- that
      // guard was already correct and race-safe; this is a real,
      // separate UX improvement, not a data-integrity fix.
      stockQuantity: r.stock_quantity,
      supplierName: supplierLabelMap.get(r.supplier_id),
      // Real weight (#23) -- already queried internally above, never
      // previously exposed to the client. Null when a real product
      // has no real weight on file rather than a fabricated default.
      weightKg: effectiveWeightKg,
      // From a quotation (migration 141): its number, who it is for and its car; null for a part from the catalogue.
      quotation: r.quotation_id ? { id: r.quotation_id, partyName: r.quotation_party, car: quotationCarLine(r.quotation_vehicle, lang) } : null,
    };
  }))).filter(Boolean);
  // Confirmed with the person: an applied promo code persists on the
  // cart itself (not just in-memory app state), but is re-validated
  // fresh on every real read here -- if it's expired or hit its
  // real usage limit since being applied, it's automatically cleared
  // from the cart record rather than shown as if still valid.
  let promoDiscountUsd = 0;
  let appliedPromoDetails = null;
  const subtotal = items.reduce((sum, i) => sum + i.price * i.quantity, 0);
  if (appliedPromoCode) {
    const validation = await validatePromoCode(appliedPromoCode, buyerId);
    if (validation.valid) {
      appliedPromoDetails = { code: appliedPromoCode, type: validation.promoCode.type, value: validation.promoCode.value === null ? null : Number(validation.promoCode.value) };
      // Matches the existing client-side _previewDiscount's own real,
      // established behavior: free_shipping's real amount depends on
      // a real server-side shipping breakdown this cart response
      // doesn't compute -- not guessed at here either, left for real
      // order-placement time where the real figure is already
      // correctly computed.
      if (validation.promoCode.type !== 'free_shipping') {
        promoDiscountUsd = calculateDiscountUsd(validation.promoCode, subtotal, 0);
      }
    } else {
      await db.query('UPDATE carts SET applied_promo_code = NULL WHERE id = $1', [cartId]);
      appliedPromoCode = null;
    }
  }

  // Confirmed with the person: real loyalty discount only ever
  // competes with a real promo code, never with the real vehicle-
  // based discount above (already applied, unconditional). Whichever
  // of these two saves the buyer more real money wins -- never both
  // stacked together.
  const loyaltyDiscountPercentage = await getLoyaltyDiscountPercentage(buyerId);
  const loyaltyDiscountUsd = Number((subtotal * (loyaltyDiscountPercentage / 100)).toFixed(2));
  let appliedDiscountSource = 'none';
  let appliedDiscountUsd = 0;
  if (loyaltyDiscountUsd > promoDiscountUsd) {
    appliedDiscountSource = 'loyalty';
    appliedDiscountUsd = loyaltyDiscountUsd;
  } else if (promoDiscountUsd > 0) {
    appliedDiscountSource = 'promo';
    appliedDiscountUsd = promoDiscountUsd;
  }

  // The shipping fee on a small order (see shared/freeShipping.js): measured on the goods AFTER the discount; a free-shipping promo code waives it. All of it is zero/off when the admin has not set a limit.
  const shipping = computeShipping({ settings: await readFreeShipping(), itemsUsd: subtotal, discountUsd: appliedDiscountUsd, freeShippingPromo: appliedPromoDetails ? appliedPromoDetails.type === 'free_shipping' : false, hasItems: items.length > 0 });

  return {
    cartId, items, appliedPromoCode, appliedPromoDetails,
    promoDiscountUsd, loyaltyDiscountPercentage, loyaltyDiscountUsd,
    appliedDiscountSource, appliedDiscountUsd,
    lockActive, lockExpiresAt,
    holdMinutes: holdRules.holdMinutes,
    shipping,
  };
}

// Real, honest note on the check below: stock isn't reserved per-cart
// (there's no "N held for this cart" concept anywhere in this schema)
// -- it's a live, shared number, same one order placement itself
// checks against. Two buyers could each pass this check for the last
// unit; only one of THEM will actually get it at real order placement,
// where the atomic guard lives. This check is a real, honest
// early-warning for the common case, not a promise of a reservation.
//
// A failed check carries a stable `code` ('insufficient_stock') plus the numbers
// (`available`, `productName` -- in the requested language, like the basket's item
// names) so a client can show its OWN translated sentence instead of this English
// one. `error` stays for older clients and for logs.
async function checkStockAvailable(productId, requestedQuantity, lang) {
  const { rows } = await db.query(`SELECT p.stock_quantity, p.name, p.name_ar, ${CAR_COLUMNS} FROM products p ${CAR_JOIN} WHERE p.id = $1`, [productId]);
  if (rows.length === 0) return { ok: false, error: 'Product not found' };
  if (requestedQuantity > rows[0].stock_quantity) {
    const productName = buyerName(rows[0], lang);
    return {
      ok: false,
      error: `Only ${rows[0].stock_quantity} of "${rows[0].name}" left in stock`,
      code: 'insufficient_stock',
      available: rows[0].stock_quantity,
      productName,
    };
  }
  return { ok: true };
}

// The JSON body for a failed stock check (fields that are undefined are simply omitted).
function stockErrorBody(stockCheck) {
  return { error: stockCheck.error, code: stockCheck.code, available: stockCheck.available, productName: stockCheck.productName };
}

router.get('/:cartId', optionalAuth, async (req, res, next) => {
  try {
    res.json(await getFullCart(req.params.cartId, req.user?.sub, req.query.lang));
  } catch (err) {
    next(err);
  }
});

// POST /:cartId/lock-prices -- confirmed with the person through
// several rounds of clarification: called when the buyer genuinely
// enters checkout, not when an item is added to the cart. If a real,
// still-active lock already exists (checkout_locked_at within the
// real last 60 minutes), this does nothing and just returns the
// current cart -- explicitly confirmed: going back to the basket
// mid-countdown and returning to checkout before it expires keeps
// the SAME real countdown running, not a reset one. Otherwise starts
// a brand new real 60-minute lock, snapshotting every item's own
// real live price at this exact moment.
router.post('/:cartId/lock-prices', optionalAuth, async (req, res, next) => {
  try {
    await ensureCartExists(req.params.cartId);
    const holdRules = await discountHold.getRules();
    const { rows: cartRows } = await db.query('SELECT checkout_locked_at, buyer_id FROM carts WHERE id = $1', [req.params.cartId]);
    const existingLockedAt = cartRows[0]?.checkout_locked_at || null;
    const alreadyActive = discountHold.isLockActive(existingLockedAt, holdRules);
    // Step 5: how many holds a day (the first one + the new ones allowed; -1 = no limit). A day in the admin's time zone.
    let limitReached = false;
    if (!alreadyActive && holdRules.maxHoldsPerDay >= 0) {
      try {
        const { rows: c } = await db.query(`SELECT holds_count, holds_day = (now() AT TIME ZONE $2)::date AS today FROM carts WHERE id = $1`, [req.params.cartId, holdRules.summaryTz]);
        limitReached = Boolean(c[0] && c[0].today && Number(c[0].holds_count) >= 1 + holdRules.maxHoldsPerDay);
      } catch (err) { limitReached = false; }
    }

    if (!alreadyActive && limitReached) {
      await discountHold.recordEvent({ cartId: req.params.cartId, kind: 'hold_limit', detail: `no new hold today (${1 + holdRules.maxHoldsPerDay} a day)` });
    }
    if (!alreadyActive && !limitReached) {
      const { rows } = await db.query(
        `SELECT ci.product_id, p.price, p.currency_code, p.category, p.part, p.weight_kg, p.length_cm, p.width_cm, p.height_cm
         FROM cart_items ci JOIN products p ON p.id = ci.product_id WHERE ci.cart_id = $1`,
        [req.params.cartId]
      );
      await Promise.all(rows.map(async (r) => {
        const live = await computeLivePrice(r).catch((err) => { if (err instanceof MissingShippingDataError) return null; throw err; });
        if (!live) return;      // cannot be priced: not locked (it is not shown in the cart either)
        // every unit is on the held line again; nothing added later yet
        await db.query('UPDATE cart_items SET locked_price = $1, held_quantity = quantity, extra_locked_price = NULL WHERE cart_id = $2 AND product_id = $3', [live.price, req.params.cartId, r.product_id]);
      }));
      await db.query('UPDATE carts SET checkout_locked_at = now() WHERE id = $1', [req.params.cartId]);
      try {
        await db.query(`UPDATE carts SET holds_count = CASE WHEN holds_day = (now() AT TIME ZONE $2)::date THEN holds_count + 1 ELSE 1 END, holds_day = (now() AT TIME ZONE $2)::date, hold_end_told_at = NULL WHERE id = $1`, [req.params.cartId, holdRules.summaryTz]);
      } catch (err) { /* migration 143 not run yet */ }
      await discountHold.recordEvent({ cartId: req.params.cartId, kind: 'hold_started', detail: `${rows.length} part(s) held for ${holdRules.holdMinutes} min` });
      if (holdRules.tellHoldStart) await discountHold.tellBuyer(req.user?.sub || cartRows[0]?.buyer_id, discountHold.words.holdStarted(holdRules.holdMinutes));
      if (holdRules.notifyMode === 'each') await discountHold.notifyAdmins({ title: 'A price hold started', body: `Basket ${req.params.cartId}: ${rows.length} part(s) held for ${holdRules.holdMinutes} minutes.` });
    }
    res.json({ ...(await getFullCart(req.params.cartId, req.user?.sub, req.query.lang)), holdLimitReached: !alreadyActive && limitReached });
  } catch (err) {
    next(err);
  }
});

// PATCH /:cartId/promo-code  { code: string | null } -- applies or
// clears the real, persisted promo code on this cart (migration 075).
// Confirmed with the person: this survives the buyer leaving the
// checkout screen entirely, even closing and reopening the app,
// since it's stored on the real cart record itself, not just
// in-memory app state.
router.patch('/:cartId/promo-code', optionalAuth, async (req, res, next) => {
  try {
    const { code } = req.body || {};
    await ensureCartExists(req.params.cartId);
    if (!code) {
      await db.query('UPDATE carts SET applied_promo_code = NULL WHERE id = $1', [req.params.cartId]);
      return res.json(await getFullCart(req.params.cartId, req.user?.sub, req.query.lang));
    }
    const { rows: cartRows } = await db.query('SELECT buyer_id FROM carts WHERE id = $1', [req.params.cartId]);
    const validation = await validatePromoCode(code, req.user?.sub || cartRows[0]?.buyer_id || null);
    if (!validation.valid) {
      return res.status(400).json({ error: validation.reason });
    }
    await db.query('UPDATE carts SET applied_promo_code = $1 WHERE id = $2', [code, req.params.cartId]);
    res.json(await getFullCart(req.params.cartId, req.user?.sub, req.query.lang));
  } catch (err) {
    next(err);
  }
});

// Steps 3 and 1 of the discount-hold rules, after a part's quantity went from `before` (its row, or null) to `quantity`:
// during a hold, units added after the discount ended are a new line at the live price (held until the same hold ends); while the
// discount is still on they join the held line or make a new line (addWhileOn). Fewer units: the later units go first.
async function afterQuantityChange(req, productId, before, quantity) {
  try {
    const rules = await discountHold.getRules();
    const cartId = req.params.cartId;
    const { rows: c } = await db.query('SELECT checkout_locked_at, buyer_id FROM carts WHERE id = $1', [cartId]);
    const lockedAt = c[0]?.checkout_locked_at || null;
    const pct = await findMatchingDiscountRule(productId);
    if (!before) await db.query('UPDATE cart_items SET discount_seen_pct = $3 WHERE cart_id = $1 AND product_id = $2', [cartId, productId, pct]);
    if (!discountHold.isLockActive(lockedAt, rules)) return;
    const { rows: pr } = await db.query(`SELECT p.id AS product_id, p.name, p.name_ar, p.price, p.currency_code, p.category, p.part, p.weight_kg, p.length_cm, p.width_cm, p.height_cm, ${CAR_COLUMNS} FROM products p ${CAR_JOIN} WHERE p.id = $1`, [productId]);
    if (!pr[0]) return;
    const live = await computeLivePrice(pr[0]);
    if (!before || before.locked_price === null) {
      // a part that was not in the basket when checkout was opened: held at the price it was added at
      await db.query('UPDATE cart_items SET locked_price = $3, held_quantity = quantity, extra_locked_price = NULL WHERE cart_id = $1 AND product_id = $2', [cartId, productId, live.price]);
      return;
    }
    const heldBefore = before.held_quantity === null ? Number(before.quantity) : Number(before.held_quantity);
    const added = quantity - Number(before.quantity);
    if (added < 0) {
      await db.query('UPDATE cart_items SET held_quantity = LEAST(COALESCE(held_quantity, $3), quantity) WHERE cart_id = $1 AND product_id = $2', [cartId, productId, heldBefore]);
      return;
    }
    if (added === 0) return;
    const name = buyerName(pr[0], 'en');
    if (pct !== null && rules.addWhileOn === 'join') {
      await db.query('UPDATE cart_items SET held_quantity = $3 WHERE cart_id = $1 AND product_id = $2', [cartId, productId, heldBefore + added]);
      await discountHold.recordEvent({ cartId, productId, kind: 'joined_hold', detail: `${added} more joined the held line` });
      return;
    }
    const extraPrice = before.extra_locked_price === null ? live.price : Math.min(Number(before.extra_locked_price), live.price);
    await db.query('UPDATE cart_items SET held_quantity = $3, extra_locked_price = $4 WHERE cart_id = $1 AND product_id = $2', [cartId, productId, heldBefore, extraPrice]);
    await discountHold.recordEvent({ cartId, productId, kind: 'new_line', detail: `${added} added at ${discountHold.usd(extraPrice)} (held line ${discountHold.usd(before.locked_price)})` });
    if (rules.tellNewLine && extraPrice > Number(before.locked_price) + 0.004) await discountHold.tellBuyer(req.user?.sub || c[0]?.buyer_id, discountHold.words.newLine(name, extraPrice, Number(before.locked_price)), { type: 'product', id: productId });
  } catch (err) {
    console.error('[discount-hold] basket line not updated (non-fatal):', err.message);
  }
}
const rowBefore = async (cartId, productId) => {
  try {
    const { rows } = await db.query('SELECT quantity, locked_price, held_quantity, extra_locked_price FROM cart_items WHERE cart_id = $1 AND product_id = $2', [cartId, productId]);
    return rows[0] || null;
  } catch (err) {
    const { rows } = await db.query('SELECT quantity, locked_price FROM cart_items WHERE cart_id = $1 AND product_id = $2', [cartId, productId]);
    return rows[0] ? { ...rows[0], held_quantity: null, extra_locked_price: null } : null;
  }
};

router.post('/:cartId/items', optionalAuth, async (req, res, next) => {
  try {
    const { productId, quantity } = req.body || {};
    if (!productId || !quantity) {
      return res.status(400).json({ error: 'productId and quantity are required' });
    }
    // Real stock check (new) -- see checkStockAvailable's own comment
    // for why this is an early warning, not a reservation. Checks the
    // REAL resulting total (existing cart quantity + this add), not
    // just the newly-requested amount, since POST adds rather than sets.
    const { rows: existingRows } = await db.query('SELECT quantity FROM cart_items WHERE cart_id = $1 AND product_id = $2', [req.params.cartId, productId]);
    const existingQuantity = existingRows[0]?.quantity || 0;
    const stockCheck = await checkStockAvailable(productId, existingQuantity + quantity, req.query.lang);
    if (!stockCheck.ok) return res.status(400).json(stockErrorBody(stockCheck));

    await ensureCartExists(req.params.cartId);
    const before = await rowBefore(req.params.cartId, productId);
    await db.query(
      `INSERT INTO cart_items (cart_id, product_id, quantity) VALUES ($1, $2, $3)
       ON CONFLICT (cart_id, product_id) DO UPDATE SET quantity = cart_items.quantity + EXCLUDED.quantity`,
      [req.params.cartId, productId, quantity]
    );
    await afterQuantityChange(req, productId, before, (before ? Number(before.quantity) : 0) + Number(quantity));
    res.status(201).json(await getFullCart(req.params.cartId, req.user?.sub, req.query.lang));
  } catch (err) {
    next(err);
  }
});

// PATCH /:cartId/items/:productId  { quantity } — sets the EXACT quantity
// (unlike POST above, which adds to whatever's already there). Needed for
// a quantity stepper UI (+/- buttons) where the client knows the target
// count rather than a delta. quantity <= 0 removes the item entirely.
router.patch('/:cartId/items/:productId', optionalAuth, async (req, res, next) => {
  try {
    const { quantity } = req.body || {};
    if (typeof quantity !== 'number') {
      return res.status(400).json({ error: 'quantity (number) is required' });
    }
    if (quantity <= 0) {
      await db.query('DELETE FROM cart_items WHERE cart_id = $1 AND product_id = $2', [req.params.cartId, req.params.productId]);
    } else {
      // Real stock check (new) -- see checkStockAvailable's own
      // comment. PATCH sets the exact quantity, so the requested
      // amount IS the real resulting total (unlike POST above).
      const stockCheck = await checkStockAvailable(req.params.productId, quantity, req.query.lang);
      if (!stockCheck.ok) return res.status(400).json(stockErrorBody(stockCheck));

      await ensureCartExists(req.params.cartId);
      // { quotationId } (optional): the part comes from that quotation of the buyer's; a later change of quantity keeps the mark.
      const quotationId = await quotationFor(req, req.params.productId);
      const before = await rowBefore(req.params.cartId, req.params.productId);
      await db.query(
        `INSERT INTO cart_items (cart_id, product_id, quantity, quotation_id) VALUES ($1, $2, $3, $4)
         ON CONFLICT (cart_id, product_id) DO UPDATE SET quantity = EXCLUDED.quantity, quotation_id = COALESCE(EXCLUDED.quotation_id, cart_items.quotation_id)`,
        [req.params.cartId, req.params.productId, quantity, quotationId]
      );
      await afterQuantityChange(req, req.params.productId, before, quantity);
    }
    res.json(await getFullCart(req.params.cartId, req.user?.sub, req.query.lang));
  } catch (err) {
    next(err);
  }
});

router.delete('/:cartId/items/:productId', optionalAuth, async (req, res, next) => {
  try {
    await db.query('DELETE FROM cart_items WHERE cart_id = $1 AND product_id = $2', [req.params.cartId, req.params.productId]);
    res.json(await getFullCart(req.params.cartId, req.user?.sub, req.query.lang));
  } catch (err) {
    next(err);
  }
});

router.getFullCart = getFullCart;      // used by the account cart layer's POST /:cartId/clear
module.exports = require('./accountCart').accountCartRouter(router);
