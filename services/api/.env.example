# Copy to services/api/.env and fill in real values locally.
# Never commit the actual .env file — it's excluded via .gitignore.

# --- Database ---
# See db/README.md for local PostgreSQL setup instructions.
# Format: postgresql://<user>:<password>@<host>:5432/<database_name>
DATABASE_URL=

# --- Payment gateways ---
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=   <- NOT read by any code yet
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# GOOGLE_PAY_MERCHANT_ID=   <- NOT read by any code yet

# Amazon Payment Services (formerly PayFort) — get these from your APS
# merchant dashboard. APS_API_BASE_URL differs for sandbox vs production;
# confirm the current correct value there, don't guess.
APS_MERCHANT_IDENTIFIER=
APS_ACCESS_CODE=
APS_SHA_REQUEST_PHRASE=
APS_SHA_RESPONSE_PHRASE=
APS_API_BASE_URL=

# Add region-specific gateway credentials as they're approved (e.g. Mada)

# --- Notifications ---
# SMS_PROVIDER_API_KEY=   <- NOT read by any code yet
# (Email is configured by the SMTP_* settings below, not by an API key.)
# PUSH_NOTIFICATION_SERVER_KEY=   <- NOT read by any code yet (push uses FIREBASE_SERVICE_ACCOUNT_JSON below)

# --- Email (any SMTP provider: Resend, Brevo, Mailgun, Amazon SES ...; or Mailpit for testing) ---
# All five are needed together. With none of them set, emails are printed in the backend window instead of being sent.
# Test locally without a provider: run Mailpit (see scripts/README.md) and use  SMTP_HOST=127.0.0.1  SMTP_PORT=1025  SMTP_USER=dev  SMTP_PASSWORD=dev
# Check it with:  node scripts/send-test-email.js you@example.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Leap Auto Parts

# --- Translation ---
# TRANSLATION_API_KEY=   <- NOT read by any code yet (the code reads GOOGLE_TRANSLATE_API_KEY below)

# --- Tax / VAT (if a third-party service is selected, see Charter Section 1) ---
# TAX_SERVICE_API_KEY=   <- NOT read by any code yet

# --- Auth ---
JWT_SECRET=

# --- Real, encrypted payment provider credentials (migration 065) ---
# Master key used to encrypt/decrypt real gateway credentials
# (Stripe, PayPal, APS, and any future provider) at rest in the
# database, entered through the admin portal's own real "set up"
# pages rather than as separate environment variables per provider.
# Generate a real, random 32-byte value for production, e.g.:
#   openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# --- Real carrier tracking (17TRACK webhook, migration 026) ---
# The real shared secret 17TRACK signs its webhook payloads with — get
# this from your 17TRACK dashboard's webhook settings. The webhook
# endpoint fails closed (rejects everything) if this isn't set.
TRACK17_WEBHOOK_SECRET=

# The address the QR code on the hub's address label points at. It must be reachable from the COURIER's phone: your public API domain in
# production; for a test on your own Wi-Fi use your PC's address, e.g. http://192.168.0.210:4000 (default: http://localhost:PORT, which only
# works on the PC itself).
# PUBLIC_API_URL=http://192.168.0.210:4000

# --- Settings the server reads that were missing from this file (see docs/LAUNCH-CHECKLIST.md; `node scripts/check-launch-readiness.js` checks them) ---
# PORT=4000                         <- optional: the port the backend listens on (default 4000)
# NODE_ENV=production                 <- set ONLY on the live server: switches on the start-up safety checks (it refuses weak secrets)
# The public addresses emails link to (buyer welcome email, supplier emails). https:// and your real domain in production.
STOREFRONT_URL=
SUPPLIER_PORTAL_URL=
# Live courier tracking (17TRACK). The webhook secret is further up.
TRACK17_API_KEY=
# Phone push notifications: the Firebase service account, as ONE line of JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Photo storage. Without these, uploaded photos stay on the server's own disk (lost if the server is replaced, not backed up).
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for S3-compatible services that are not Amazon (e.g. Cloudflare R2, DigitalOcean Spaces), and the public address the photos are served from:
S3_ENDPOINT=
S3_PUBLIC_URL_BASE=
# Automatic translation of supplier products (Google Cloud Translation).
GOOGLE_TRANSLATE_API_KEY=
